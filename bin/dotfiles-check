#!/usr/bin/env bash
#
# dotfiles-check — lint this repo before it lints you.
#
#   dotfiles-check          # run every check, exit non-zero on any failure
#   dotfiles-check -q       # only print failures
#
# Every check here exists because the corresponding bug actually happened:
#
#   dangling link targets   install.conf.yaml declared a link to
#                           config/fish/functions/rip-cd.fish before that file
#                           existed, so `bootstrap.sh desktop` would have failed
#                           (ADR-0009 audit). Separately, config/git/config has
#                           ended with `[include] path = local` since it was
#                           written and nothing ever created the target — git
#                           ignores a missing include silently, so user.email
#                           was unset for weeks while a stray ~/.gitconfig
#                           quietly supplied it.
#
#   shell syntax            a --dry-run that installed seven packages, a sed
#                           whose delimiter appeared in its own pattern, a
#                           `die` inside a process substitution that killed
#                           only the subshell. bash -n catches the cheap third
#                           of that class for free.
#
#   duplicate packages      common.txt is for names identical on both distros.
#                           Listing something in common AND fedora installs it
#                           twice and hides which file is authoritative.
#
#   bundle references       a typo in machines/<profile>.bundles used to be
#                           non-fatal, silently installing nothing.
#
#   tbx directives          the legend at the top of toolboxes/uni.txt parsed
#                           as a directive and won, so `tbx create uni` tried
#                           to pull an image called "container base image" and
#                           mkdir'd a directory named after a help string.
#
#   executable bits         the repo was copied from a mounted folder that
#                           doesn't preserve modes; bootstrap.sh arrived
#                           non-executable.
#
#   secrets                 03-conventions/dotfiles.md says "add a pre-commit
#                           check for keys/tokens". This is it. Matters more
#                           the moment this repo goes public.
#
# Deliberately read-only. It reports; it never edits.

set -Eeuo pipefail

# RESOLVE SYMLINKS before deriving the repo root.
#
# This script is linked into ~/.local/bin by install.conf.yaml, and
# ${BASH_SOURCE[0]} reports the LINK path, not its target. Without readlink -f,
# running `dotfiles-check` from $PATH set BASEDIR to ~/.local — so it linted
# ~/.local/bin (the binaries tbx exports from the uni container), found zero
# dotbot configs and zero package lists, and scanned ~/.local/share for
# secrets, where Steam's runtime and podman's overlays are full of example
# PEM files. Eight false failures and every real check silently skipped
# (2026-08-23).
BASEDIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

QUIET=0
[[ "${1:-}" == "-q" || "${1:-}" == "--quiet" ]] && QUIET=1

FAILURES=0

# Refuse to run anywhere that isn't the dotfiles repo. The bug above was only
# survivable because it was obvious in the output; a subtler wrong root would
# have reported "all checks passed" while checking nothing at all.
for required in install.conf.yaml packages bin machines; do
  [[ -e "$BASEDIR/$required" ]] || {
    printf '\033[31merror:\033[0m %s does not look like the dotfiles repo (no %s)\n' \
      "$BASEDIR" "$required" >&2
    exit 2
  }
done

hdr()  { ((QUIET)) || printf '\n\033[36m==>\033[0m %s\n' "$*"; }
ok()   { ((QUIET)) || printf '  \033[32mok\033[0m    %s\n' "$*"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; FAILURES=$((FAILURES+1)); }
note() { ((QUIET)) || printf '  \033[33mnote\033[0m  %s\n' "$*"; }

clean_list() { sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$1" 2>/dev/null; }

# --------------------------------------------------------------- shell syntax
hdr "shell syntax"
while read -r f; do
  [[ -f "$f" ]] || continue
  head -c2 "$f" | grep -q '^#!' || continue
  if bash -n "$f" 2>/dev/null; then ok "${f#$BASEDIR/}"
  else fail "${f#$BASEDIR/} — bash -n reports a syntax error"; fi
done < <(find "$BASEDIR/bin" "$BASEDIR/hooks" "$BASEDIR" -maxdepth 1 -type f 2>/dev/null | sort -u)

# hooks/ is included above deliberately. It was not, until 2026-08-24, and
# hooks/pre-commit is the script with the WORST failure mode in the repo: a
# syntax error there makes every `git commit` fail, and the check that would
# have caught it is this one. Its executable bit was already checked twenty
# lines below, which made the omission easy to miss.

# ------------------------------------------------------------ executable bits
hdr "executable bits"
for f in "$BASEDIR"/bin/* "$BASEDIR/bootstrap.sh" "$BASEDIR"/hooks/*; do
  [[ -f "$f" ]] || continue
  if [[ -x "$f" ]]; then ok "${f#$BASEDIR/}"
  else fail "${f#$BASEDIR/} is not executable (git tracks the bit: chmod +x, then commit)"; fi
done

# Anything a dotbot config declares with `mode: 755` must ALSO be executable
# in the repo.
#
# `mode` IS NOT A DOTBOT OPTION — confirmed 2026-08-24 by reading the vendored
# dotbot/src/dotbot/plugins/link.py. It reads backup, canonicalize-path,
# create, exclude, force, glob, if, ignore-missing, link, path, prefix,
# relative, relink and type. There is no `mode` and no `chmod` in the file;
# unknown keys are ignored without a word.
#
# What actually carries the bit is git, on the source file — a symlink has no
# mode of its own. config/river/init was committed 644 while thinkpad.yaml
# confidently said mode: 755, and river execs its init directly: the result
# would have been a session with no keybindings at all, discovered at a login
# screen (2026-08-23).
#
# This section is therefore the ONLY thing that gives those `mode:` lines any
# effect at all. They are assertions aimed at this linter, and the machine
# profiles say so.
while read -r src; do
  [[ -n "$src" ]] || continue
  if [[ -x "$BASEDIR/$src" ]]; then ok "$src (declared mode 755, is executable)"
  else fail "$src is declared mode 755 but is NOT executable in the repo"; fi
done < <(python3 - "$BASEDIR" <<'PY'
import sys, glob, os, yaml
base = sys.argv[1]
cfgs = [os.path.join(base, "install.conf.yaml")] + glob.glob(os.path.join(base, "machines", "*.yaml"))
for c in cfgs:
    if not os.path.exists(c):
        continue
    for block in (yaml.safe_load(open(c)) or []):
        if not isinstance(block, dict):
            continue
        for _dest, val in (block.get("link") or {}).items():
            if isinstance(val, dict) and str(val.get("mode", "")).endswith("755") and "path" in val:
                print(val["path"])
PY
)

# --------------------------------------------------------------- dotbot YAML
hdr "dotbot configs parse, and every link source exists"
# A section that examines nothing must FAIL, not pass quietly. Every empty
# section here was a symptom of the wrong-BASEDIR bug and none of them said so.
checked=0
for cfg in "$BASEDIR/install.conf.yaml" "$BASEDIR"/machines/*.yaml; do
  [[ -f "$cfg" ]] || continue
  checked=$((checked+1))
  rel="${cfg#$BASEDIR/}"

  if ! python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1]))" "$cfg" 2>/dev/null; then
    fail "$rel — invalid YAML"; continue
  fi
  ok "$rel parses"

  # Emit one source path per line. dotbot link values are either a bare string
  # or a mapping with a `path:` key.
  while read -r src; do
    [[ -n "$src" ]] || continue
    if [[ -e "$BASEDIR/$src" ]]; then
      ok "  → $src"
    else
      fail "  → $src — declared in $rel but does not exist in the repo"
    fi
  done < <(python3 - "$cfg" <<'PY'
import sys, yaml
doc = yaml.safe_load(open(sys.argv[1])) or []
for block in doc:
    if not isinstance(block, dict):
        continue
    for dest, val in (block.get("link") or {}).items():
        if isinstance(val, str):
            print(val)
        elif isinstance(val, dict) and "path" in val:
            print(val["path"])
PY
  )
done

((checked)) || fail "no dotbot configs found under $BASEDIR — nothing was checked"

# ------------------------------------------------------------- package lists
hdr "package lists"
COMMON="$BASEDIR/packages/common.txt"
[[ -f "$COMMON" ]] || fail "packages/common.txt not found — nothing was checked"
for distro in fedora cachyos; do
  d="$BASEDIR/packages/${distro}.txt"
  [[ -f "$COMMON" && -f "$d" ]] || continue
  dupes="$(comm -12 <(clean_list "$COMMON" | sort -u) <(clean_list "$d" | sort -u))"
  if [[ -z "$dupes" ]]; then ok "no overlap between common.txt and ${distro}.txt"
  else while read -r p; do
         fail "$p is in BOTH common.txt and ${distro}.txt — pick one"
       done <<< "$dupes"
  fi
done

for f in "$BASEDIR"/packages/*.txt "$BASEDIR"/packages/bundles/*.txt; do
  [[ -f "$f" ]] || continue
  rel="${f#$BASEDIR/}"
  d="$(clean_list "$f" | sort | uniq -d)"
  [[ -z "$d" ]] || while read -r p; do fail "$rel lists '$p' more than once"; done <<< "$d"
done

for b in "$BASEDIR"/packages/bundles/*.txt; do
  [[ -f "$b" ]] || continue
  name="$(basename "$b" .txt)"
  overlap="$(comm -12 <(clean_list "$b" | sort -u) \
                      <(cat <(clean_list "$COMMON") \
                            <(clean_list "$BASEDIR/packages/fedora.txt") \
                            <(clean_list "$BASEDIR/packages/cachyos.txt") 2>/dev/null | sort -u))"
  if [[ -z "$overlap" ]]; then ok "bundle '$name' declares nothing already in the base lists"
  else while read -r p; do
         fail "bundle '$name' also lists '$p', which is already installed on every machine"
       done <<< "$overlap"
  fi
done

# --------------------------------------------------------- bundle references
hdr "machine bundle references resolve"
shopt -s nullglob
for bf in "$BASEDIR"/machines/*.bundles; do
  profile="$(basename "$bf" .bundles)"
  # `tr -d ' \t'`, NOT `tr -d '[:space:]'` — the latter deletes newlines too,
  # joining every entry into one unterminated line. `read` then returns false
  # immediately and the loop body never executes: a check that silently
  # examines nothing and reports success. Caught while testing this script
  # against a repo with a deliberate typo (2026-08-23).
  #
  # `|| [[ -n "$name" ]]` handles a final line with no trailing newline, which
  # read would otherwise discard for the same reason.
  while read -r name || [[ -n "$name" ]]; do
    name="${name//[[:space:]]/}"
    [[ -n "$name" ]] || continue
    if [[ -f "$BASEDIR/packages/bundles/${name}.txt" ]]; then ok "$profile → $name"
    else fail "$profile declares bundle '$name' but packages/bundles/${name}.txt does not exist"; fi
  done < <(clean_list "$bf" | tr -d ' \t')
done
shopt -u nullglob

# ------------------------------------------------------------ tbx directives
hdr "toolbox directives"
for t in "$BASEDIR"/toolboxes/*.txt; do
  [[ -f "$t" ]] || continue
  name="$(basename "$t" .txt)"
  # tail -n1: the header legend is written without colons so it can't match,
  # but take the last occurrence anyway — that is what bin/tbx does.
  image="$(sed -n 's/^#[[:space:]]*tbx-image:[[:space:]]*//p' "$t" | tail -n1)"
  home="$(sed -n 's/^#[[:space:]]*tbx-home:[[:space:]]*//p' "$t" | tail -n1)"

  if [[ -z "$image" ]]; then note "$name has no tbx-image (will use tbx's default)"
  elif [[ "$image" =~ ^[a-z0-9._/-]+(:[a-zA-Z0-9._-]+)?$ ]]; then ok "$name image: $image"
  else fail "$name tbx-image is not a container reference: '$image'"; fi

  if [[ -n "$home" ]]; then
    if [[ "$home" == ~* || "$home" == /* ]]; then ok "$name home: $home"
    else fail "$name tbx-home must be absolute or ~/…, got: '$home'"; fi
  fi
done

# ------------------------------------------------- invoked but never declared
#
# 03-conventions/dotfiles.md: "If it's part of the setup, it goes in a package
# list." Nothing enforced that until now, and an audit on 2026-08-24 found
# three live violations — btop (waybar's cpu/memory modules open it on click),
# wireplumber (wpctl, behind every volume binding and the waybar audio module)
# and playerctl — plus two "already installed" comments standing in for
# declarations. All would surface as a broken feature on a rebuilt machine,
# never as an install error.
#
# SCOPE IS DELIBERATELY NARROW, because a noisy check gets switched off. Only
# two kinds of site are scanned:
#   1. `command -v X` in bin/ — the author explicitly naming a dependency.
#   2. The first word of a `spawn '...'` in river's init and of an "on-click"
#      in waybar's config — the places a keybinding or a click reaches out to
#      something that has to exist.
hdr "external commands are declared in a package list"

DECLARED="$(mktemp)"
trap 'rm -f "$DECLARED"' EXIT
cat "$BASEDIR"/packages/*.txt "$BASEDIR"/packages/bundles/*.txt 2>/dev/null \
  | sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' | sort -u > "$DECLARED"

# Binaries whose package has a DIFFERENT name. Without this map the check
# reports river-classic's own `riverctl` as undeclared and is useless.
provider() {
  case "$1" in
    river|riverctl|rivertile)  echo river-classic ;;
    swaync|swaync-client)      echo SwayNotificationCenter ;;
    nm-applet)                 echo network-manager-applet ;;
    blueman-applet|blueman-manager) echo blueman ;;
    wpctl)                     echo wireplumber ;;
    wl-copy|wl-paste)          echo wl-clipboard ;;
    notify-send)               echo libnotify ;;
    nvim)                      echo neovim ;;
    fd)                        echo fd-find ;;
    *)                         echo "$1" ;;
  esac
}

# Membership test that does not care how the lists below are wrapped.
#
# The obvious `case "$LIST" in *" $cmd "*)` is subtly wrong for any entry that
# sits at the end of a line: the character after it is a newline, not a space,
# so the pattern never matches. That is why 'nvidia-smi' — which WAS in the
# optional list — still got reported. Collapsing the whitespace first makes
# the list's line breaks purely cosmetic, which is what they were meant to be.
in_list() {
  local needle="$1" list="$2"
  # shellcheck disable=SC2086  # unquoted on purpose: collapses all whitespace
  case " $(echo $list) " in *" $needle "*) return 0 ;; esac
  return 1
}

# Part of the base install on both distros. Declaring these buys nothing and
# would make the check read as noise.
BASE_CMDS=" sh bash test true false printf echo cat head tail cut tr sort uniq
 comm wc grep sed awk find xargs stat cmp mktemp basename dirname readlink
 chmod mkdir cp mv rm ln ls date sleep kill env install tee shuf mountpoint
 pgrep pkill fc-cache fc-list python3 systemctl systemd-run dbus-update-activation-environment
 gsettings hostname sha256sum id ps which command sudo git ssh scp tar gzip
 unzip curl "

# waybar's OWN action verbs, not programs. An "on-click" may name an internal
# action instead of a shell command — wlr/taskbar takes "activate" and "close",
# clock takes "mode", "shift_up" and "shift_down". Looking for a package called
# "close" is a category error.
WAYBAR_ACTIONS=" activate close fullscreen minimize maximize mode
 shift_up shift_down shift_reset tz_up tz_down up down "

# Probes, not dependencies. `command -v dnf` asks "which distro is this",
# and `command -v conda` asks "is there a leftover conda to warn about" —
# answering "no" is a valid, expected outcome. Declaring these would be wrong:
# the whole point is that they may be absent.
OPTIONAL_CMDS=" dnf dnf5 pacman apt apt-get yay paru conda mamba nvidia-smi
 lspci lsblk flatpak snap zypper toolbox docker "

undeclared=0
while read -r cmd; do
  [[ -n "$cmd" ]] || continue
  in_list "$cmd" "$BASE_CMDS"      && continue
  in_list "$cmd" "$OPTIONAL_CMDS"  && continue
  in_list "$cmd" "$WAYBAR_ACTIONS" && continue
  # This repo's own scripts. They are checked by the link and executable-bit
  # sections; they are not packages and never will be.
  [[ -e "$BASEDIR/bin/$cmd" ]] && continue
  pkg="$(provider "$cmd")"
  grep -qxF "$pkg" "$DECLARED" && continue
  fail "'$cmd' is invoked by this repo but neither it nor '$pkg' is in any package list"
  undeclared=$((undeclared + 1))
done < <(
  {
    # COMMENT LINES ARE STRIPPED FIRST, in every one of these.
    #
    # Without that, the check reads prose. The first version of this section
    # reported 'X' (from a comment in this very file reading "`command -v X`
    # in bin/"), plus 'terminal', 'onto', 'close', 'activate', 'mode' and
    # 'it.' — all from English sentences in comments that happened to contain
    # the word "spawn". Thirteen findings, four of them real. A check that
    # cries wolf nine times out of thirteen is a check that gets deleted.

    # 1. explicit dependency guards in bin/ — the author naming a requirement.
    grep -rh --include='*' -v '^[[:space:]]*#' "$BASEDIR/bin" 2>/dev/null \
      | grep -oE 'command -v [A-Za-z0-9_.-]+' | awk '{print $3}'

    # 2. what a keybinding reaches for. First word after `spawn`, skipping
    #    $-expansions and absolute paths — those are this repo's own scripts.
    grep -rhv '^[[:space:]]*#' "$BASEDIR/config/river" 2>/dev/null \
      | grep -oE "spawn +'?\"?[A-Za-z0-9_.-]+" | sed -E "s/spawn +'?\"?//"

    # 3. what a bar click reaches for. JSONC comments start with // at the
    #    start of a line here, so the same strip applies.
    grep -rhv '^[[:space:]]*//' "$BASEDIR/config/waybar" 2>/dev/null \
      | grep -oE '"on-click[^"]*": *"[A-Za-z0-9_.-]+' | sed -E 's/.*": *"//'

    # 4. `kitty -e <cmd>` — the module opens a program INSIDE a terminal, so
    #    the dependency is the word after -e, not kitty.
    grep -rhv '^[[:space:]]*//' "$BASEDIR/config/waybar" 2>/dev/null \
      | grep -oE ' -e +[A-Za-z0-9_.-]+' | awk '{print $2}'
  } | sort -u
)
((undeclared)) || ok "every external command this repo invokes is declared"

# ------------------------------------------------------------------- secrets
hdr "secrets"
# High-signal patterns only. A scanner that flags every line containing the
# word "password" gets switched off within a week, and this repo legitimately
# discusses password FILE PATHS all over the place.
PATTERNS=(
  'BEGIN [A-Z ]*PRIVATE KEY'
  'ghp_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'AKIA[0-9A-Z]{16}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  '-----BEGIN CERTIFICATE-----'
)
hits=0
for pat in "${PATTERNS[@]}"; do
  while read -r line; do
    [[ -n "$line" ]] || continue
    fail "possible secret: $line"; hits=$((hits+1))
  done < <(grep -rnE --exclude-dir=.git --exclude-dir=dotbot "$pat" "$BASEDIR" 2>/dev/null || true)
done
((hits)) || ok "no private keys or provider tokens found"

# Belt and braces: the two files that must never be committed.
#
# The `ok` line is conditional on having found nothing. It used to be
# unconditional, so a repo that DID contain config/restic/password printed
# both "FAIL config/restic/password exists in the repo" and "ok no password or
# key file present in the repo" — and the reassuring line came second, which is
# the one a person skims. Fixed 2026-08-24.
forbidden_found=0
for forbidden in "config/restic/password" ".ssh/id_ed25519"; do
  if [[ -e "$BASEDIR/$forbidden" ]]; then
    fail "$forbidden exists in the repo — it must not"
    forbidden_found=1
  fi
done
((forbidden_found)) || ok "no password or key file present in the repo"

# ---------------------------------------------------------------------- done
echo
if ((FAILURES)); then
  printf '\033[31m%d check(s) failed\033[0m\n' "$FAILURES"
  exit 1
fi
printf '\033[32mall checks passed\033[0m\n'
