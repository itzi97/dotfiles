#!/usr/bin/env bash
#
# backup-local — restic snapshot of the things I cannot re-download.
#
# ADR-0014 (tool + local target), ADR-0017 (off-site target: a Hetzner Storage
# Box over SFTP, NOT the Cloud VPS's own disk — see that ADR for why the
# earlier sftp:hetzner:/srv/backups path was a placeholder that could not work).
#
# Runs on any machine. The snapshot tag derives from the hostname so two hosts
# can share one repository safely; see the TAG comment below, which is the
# load-bearing part of this script.
#
#   backup-local            # snapshot, then prune to the retention policy
#   backup-local --dry-run  # show what would be sent, change nothing
#
# Failure is LOUD on purpose. "Things that break silently" is the one thing
# the operator profile calls out as intolerable, and a backup that quietly
# stopped running six weeks ago is the canonical example.

set -Eeuo pipefail

REPO="${RESTIC_REPOSITORY:-/mnt/backup-local/restic}"
PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-$HOME/.config/restic/password}"
EXCLUDES="${HOME}/.config/restic/excludes.txt"
# Off-site repos get a second exclude file that removes ~/work. Set
# RESTIC_OFFSITE=1 when pointing this script at Hetzner.
EXCLUDES_OFFSITE="${HOME}/.config/restic/excludes-offsite.txt"

# Tag derives from the hostname, it is NOT hardcoded to "desktop".
#
# ADR-0015 makes the ThinkPad the primary machine during the Canada period,
# and roadmap item 7 runs this script there against the travelling drive. With
# a hardcoded tag, both machines' snapshots would be labelled "desktop" — and
# the retention policy below is applied `--tag "$TAG"`, so `restic forget`
# would prune across machines. Two hosts sharing a tag is a data-loss bug, not
# a cosmetic one.
TAG="${RESTIC_TAG:-$(hostname -s 2>/dev/null || echo unknown)}"

DRY_RUN=()
[[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]] && DRY_RUN=(--dry-run -vv)

info() { printf '\033[36m==>\033[0m %s\n' "$*"; }
die()  {
  printf '\033[31mbackup FAILED:\033[0m %s\n' "$*" >&2
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -u critical "Backup failed" "$*" || true
  exit 1
}
trap 'die "unexpected error on line $LINENO"' ERR

command -v restic >/dev/null 2>&1 || die "restic is not installed"
[[ -r "$PASSWORD_FILE" ]] || die "no repo password at ${PASSWORD_FILE}"
[[ -f "$EXCLUDES" ]]      || die "no exclude file at ${EXCLUDES}"

# The drive being unmounted is the realistic failure, and restic would happily
# create a brand-new empty repo in the empty mountpoint if we did not check.
#
# LOCAL REPOS ONLY. `mountpoint` on a remote repository string is nonsense:
# dirname "sftp:hetzner:/srv/backups/desktop" is "sftp:hetzner:/srv/backups",
# which is not a path, so the check fails and the script dies. This file's own
# header says the Hetzner repo "will reuse this script with RESTIC_REPOSITORY
# pointed at sftp:" — it could not have. Found 2026-08-24, before that path ran
# for the first time.
# A local restic repo is a filesystem path; every remote form carries a scheme
# ("sftp:", "rest:", "s3:", "rclone:"). Match on the leading slash rather than
# enumerating schemes, so a backend restic adds later does not fall through to
# the wrong branch.
case "$REPO" in
  /*|./*|../*)
    mountpoint -q "$(dirname "$REPO")" \
      || die "$(dirname "$REPO") is not mounted — refusing to write a backup to the root filesystem"
    ;;
  *)
    info "remote repository (${REPO%%:*}) — the mountpoint check does not apply"
    ;;
esac

export RESTIC_REPOSITORY="$REPO"
export RESTIC_PASSWORD_FILE="$PASSWORD_FILE"

restic cat config >/dev/null 2>&1 \
  || die "no restic repo at ${REPO} — run: restic init"

# Paths worth keeping. Deliberately NOT ~ wholesale: dotfiles are in git and
# ~/Games is Steam's problem. ~/work IS included here — on my own hardware that
# is prudence, not bleed. It is stripped again for the off-site repo below.
PATHS=(
  "$HOME/Documents"
  "$HOME/work"
  "$HOME/Pictures"
  "$HOME/Videos"
  "$HOME/Music"
  "$HOME/Backups"
  "$HOME/dev"
  "$HOME/.dotfiles"
  "$HOME/.ssh"
  "$HOME/.config"
  # Flatpak per-application state. Added 2026-08-23 — it was missing, and it
  # is the single thing on this machine with no copy anywhere else:
  # Signal Desktop's message history lives here and does NOT restore from the
  # phone (relinking gives an empty client). Obsidian's plugins and per-vault
  # settings too; the vaults themselves are safe under Documents.
  # Large and partly regenerable — see excludes.txt for the runtime caches.
  "$HOME/.var/app"
)

EXISTING=()
for p in "${PATHS[@]}"; do [[ -e "$p" ]] && EXISTING+=("$p"); done
((${#EXISTING[@]})) || die "none of the backup paths exist — wrong user?"

info "backing up ${#EXISTING[@]} path(s) to ${REPO}"
EXCLUDE_ARGS=(--exclude-file "$EXCLUDES")
if [[ "${RESTIC_OFFSITE:-0}" == "1" ]]; then
  [[ -f "$EXCLUDES_OFFSITE" ]] || die "RESTIC_OFFSITE=1 but no ${EXCLUDES_OFFSITE}"
  EXCLUDE_ARGS+=(--exclude-file "$EXCLUDES_OFFSITE")
  # KEEP THE HOSTNAME IN THE TAG.
  #
  # This line used to read `TAG="offsite"`, which reintroduced precisely the
  # data-loss bug the comment on TAG above says it avoids: both machines would
  # tag their off-site snapshots "offsite", and `restic forget --tag offsite
  # --prune` at the bottom of this script would then apply one retention policy
  # across two hosts — deleting the ThinkPad's snapshots because the desktop
  # had newer ones. Suffix, do not replace. Found 2026-08-24.
  TAG="${TAG}-offsite"
  info "off-site mode: ~/work will NOT be sent; tag is ${TAG}"
fi

restic backup \
  --tag "$TAG" \
  "${EXCLUDE_ARGS[@]}" \
  --exclude-caches \
  --one-file-system \
  "${DRY_RUN[@]+"${DRY_RUN[@]}"}" \
  -- "${EXISTING[@]}"

if ((${#DRY_RUN[@]})); then
  info "dry run — no snapshot written, nothing pruned"
  exit 0
fi

info "applying retention policy"
restic forget \
  --tag "$TAG" \
  --keep-daily 7 --keep-weekly 4 --keep-monthly 12 --keep-yearly 2 \
  --prune

info "backup complete"
restic snapshots --tag "$TAG" --latest 3
