#!/usr/bin/env bash
#
# river-cheatsheet — searchable keybind reference, parsed from the live config.
#
# Bound to Super+Shift+H in config/river/init (H for Help; letters are
# layout-stable where symbols are not — the full reasoning lives at the
# binding). An earlier version of this header said Super+Shift+slash, which
# was never true on the Spanish layout and is exactly the kind of drift this
# script exists to prevent. The binding comment in init is the truth; this
# line is a pointer to it.
#
# It READS ~/.config/river/init rather than maintaining its own list. A cheat
# sheet that is a second copy of the bindings is a cheat sheet that lies within
# a fortnight — the same two-sources-of-truth problem as ~/Applications vs
# ~/AppImages, or the README status block that went stale in three weeks.
#
# fuzzel's dmenu mode gives a filter box for free, which is what you actually
# want: "what was the screenshot one" is a search, not a scroll.

set -euo pipefail

INIT="${XDG_CONFIG_HOME:-$HOME/.config}/river/init"
[[ -r "$INIT" ]] || { echo "no river init at $INIT" >&2; exit 1; }

parse() {
  # The init binds layout keys inside an if/else on `command -v wideriver`,
  # each branch in its own generator's vocabulary. Apply the SAME test here
  # and drop the dormant branch, so the sheet documents the machine it is
  # on rather than both possible machines at once.
  local excl='send-layout-cmd wideriver'
  command -v wideriver >/dev/null 2>&1 && excl='send-layout-cmd rivertile'

  # `riverctl map` lines, INCLUDING indented ones and ones whose mode is a
  # shell variable. The previous anchor was `^riverctl map +(normal|locked)`,
  # which silently dropped the media-key binding — it lives inside a `for
  # mode in normal locked` loop, so the line is indented and its mode field
  # is literally `$mode`. A cheat sheet that omits a binding is confidently
  # wrong in the worst way: nothing looks missing. Caught by running the
  # parser against the real init rather than eyeballing it (2026-08-24).
  grep -E '^[[:space:]]*riverctl map(-pointer)? +(\$mode|normal|locked)' "$INIT" \
  | grep -vF "$excl" \
  | sed -E '
      s/^[[:space:]]*riverctl map(-pointer)? +(\$mode|normal|locked) +//;
      s/"\$mod"/Super/g;
    ' \
  | awk '
    # --- keycap rendering ---------------------------------------------------
    # Modifier names and XF86 keysyms are what the CONFIG has to say; they are
    # not what a reference document should show. "XF86AudioRaiseVolume" tells
    # you nothing you did not already know from the action column, and reading
    # "Super+Shift+Return" is slower than seeing the three keys.
    #
    # Glyphs come from two places, and the distinction matters for fallback:
    #   ⇧ ⌃ ⌥ ⏎ ␣ ⇥ ⎋ ← ↓ ↑ →  are plain Unicode, in JetBrains Mono already
    #   󰌽 󰝝 󰝞 󰝟 󰃠 󰃞 󰐥 ...    are Nerd Font, via bin/install-nerd-font
    # If the Nerd Font is ever missing you get boxes for the second set and a
    # perfectly readable sheet from the first. Nothing here degrades to blank.
    function keycap(k) {
      if (k == "Super")    return "󰌽"
      if (k == "Shift")    return "⇧"
      if (k == "Control")  return "⌃"
      if (k == "Alt" || k == "Mod1") return "⌥"
      if (k == "Return")   return "⏎"
      if (k == "Space")    return "␣"
      if (k == "Tab")      return "⇥"
      if (k == "Escape")   return "⎋"
      if (k == "BackSpace") return "⌫"
      if (k == "Delete")   return "⌦"
      if (k == "Left")     return "←"
      if (k == "Down")     return "↓"
      if (k == "Up")       return "↑"
      if (k == "Right")    return "→"
      if (k == "Print")    return "󰄀"
      # Punctuation keysyms are lowercase in XKB ("comma", not "Comma") and
      # the config uses them that way. Matching only the capitalised form let
      # "comma" and "period" through untranslated — caught in testing.
      lk = tolower(k)
      if (lk == "period") return "."
      if (lk == "comma")  return ","
      if (lk == "slash")  return "/"
      if (lk == "minus")  return "-"
      if (lk == "equal")  return "="
      if (lk == "grave")  return "`"

      # Laptop function row. These are the bindings you reach for without
      # looking, so showing what is printed on the keycap beats the keysym.
      # Codepoints are MDI names verified against the font table (2026-08-24):
      # the media key is 󰐎 play-pause (F040E), not 󰐊 play.
      if (k == "XF86AudioRaiseVolume")  return "󰝝"
      if (k == "XF86AudioLowerVolume")  return "󰝞"
      if (k == "XF86AudioMute")         return "󰝟"
      if (k == "XF86AudioMicMute")      return "󰍭"
      if (k == "XF86AudioMedia")        return "󰐎"
      if (k == "XF86AudioPlay")         return "󰐊"
      if (k == "XF86AudioNext")         return "󰒭"
      if (k == "XF86AudioPrev")         return "󰒮"
      if (k == "XF86MonBrightnessUp")   return "󰃠"
      if (k == "XF86MonBrightnessDown") return "󰃞"
      if (k == "XF86PowerOff")          return "󰐥"

      # Mouse buttons, from map-pointer lines.
      if (k == "BTN_LEFT")   return "󰍽 L"
      if (k == "BTN_RIGHT")  return "󰍽 R"
      if (k == "BTN_MIDDLE") return "󰍽 M"

      return k
    }

    # Modifiers arrive joined: "Super+Shift". Split, cap each, rejoin with the
    # same separator so the result reads as keys rather than as a token.
    function caps(spec,   parts, i, n, out) {
      n = split(spec, parts, "+")
      out = ""
      for (i = 1; i <= n; i++)
        out = out (i > 1 ? " + " : "") keycap(parts[i])
      return out
    }

    # --- sections -----------------------------------------------------------
    # Grouped, not alphabetised. `| sort` ordered rows by glyph CODEPOINT,
    # which opened the sheet with a stray screenshot binding and scattered
    # the hardware keys to both ends — order that looks random is most of why
    # the sheet read as unfinished. Classification is by the TRANSLATED
    # action text, so it cannot drift from the wording it depends on.
    # "promote to main area" lands in layout deliberately: it is the layout
    # being rearranged, not a window property changing.
    function section(a) {
      if (a ~ /^screenshot/)                        return "7\tscreenshots"
      if (a ~ /volume|mute|brightness|play/)        return "6\tmedia & hardware"
      if (a == "terminal" || a == "launcher")       return "4\tapps & pickers"
      if (a ~ /clipboard|wallpaper|cheat sheet/)    return "4\tapps & pickers"
      if (a ~ /lock|power menu|quit river/)         return "5\tsession"
      if (a ~ /tag|scratchpad/)                     return "3\ttags"
      if (a ~ /main area|windows in main|monocle/)  return "2\tlayout"
      return "1\twindows"
    }
    {
      mods = $1; key = $2; $1 = ""; $2 = "";
      combo = (mods == "None") ? keycap(key) : caps(mods) " + " keycap(key);

      action = $0;
      gsub(/^ +/, "", action);
      gsub(/^spawn +/, "", action);
      gsub(/send-layout-cmd (rivertile|wideriver) /, "", action);
      gsub(/"/, "", action);
      gsub(/'\''/, "", action);
      gsub(/ +#.*$/, "", action);
      # The looped media binding carries its own failure guard; the guard is
      # plumbing, not part of what the key does.
      gsub(/ +2>\/dev\/null.*$/, "", action);
      gsub(/ +\|\| +true$/, "", action);

      # Shell variables the config uses; expand them to something readable
      # rather than showing a raw $name in a reference document.
      gsub(/\$scratch_tag/, "scratchpad tag", action);
      gsub(/\$all_tags/,    "all tags",       action);

      # A $ in the KEY field marks a loop body the shell was going to fill
      # in — the per-tag bindings ("$i"), which the hand-written rows at the
      # bottom describe once instead of nine times. The old anchored grep
      # excluded these lines by the accident of their indentation; now that
      # indented lines are parsed on purpose (the media key lives in one),
      # the exclusion has to be said out loud. The test is combo ONLY: a $
      # in the action is usually legitimate shell ($HOME, $(slurp)) and
      # testing it too silently dropped every screenshot and picker row —
      # caught by counting rows before and after (2026-08-24).
      if (combo ~ /\$/) next;

      # Long shell pipelines are noise in a cheat sheet; name them instead.
      if (action ~ /cliphist/) action = "clipboard history";
      if (action ~ /grim.*swappy/) action = "screenshot region → annotate";
      if (action ~ /grim.*wl-copy/) action = "screenshot region → clipboard";
      if (action ~ /grim ~\/Pictures/) action = "screenshot screen → file";
      if (action ~ /wpctl set-volume.*%\+/) action = "volume up";
      if (action ~ /wpctl set-volume.*%-/) action = "volume down";
      if (action ~ /wpctl set-mute @DEFAULT_AUDIO_SINK/) action = "mute";
      if (action ~ /wpctl set-mute @DEFAULT_AUDIO_SOURCE/) action = "mic mute";
      if (action ~ /brightnessctl set 5%\+/) action = "brightness up";
      if (action ~ /brightnessctl set 5%-/) action = "brightness down";
      if (action ~ /playerctl play-pause/) action = "media play / pause";

      # riverctl verbs are not English. "main-ratio -0.05" and "zoom" are
      # precise and mean nothing to someone who opened this sheet BECAUSE
      # they could not remember what the binding did. Translate to the effect,
      # not the command — the command is in the init if you want it.
      if (action == "toggle-fullscreen")  action = "fullscreen";
      if (action == "toggle-float")       action = "float / tile";
      if (action == "close")              action = "close window";
      if (action == "exit")               action = "quit river";
      if (action == "zoom")               action = "promote to main area";
      if (action == "focus-view next")    action = "focus next window";
      if (action == "focus-view previous") action = "focus previous window";
      if (action == "swap next")          action = "swap with next";
      if (action == "swap previous")      action = "swap with previous";
      if (action == "main-ratio +0.05")   action = "grow main area";
      if (action == "main-ratio -0.05")   action = "shrink main area";
      if (action == "main-count +1")      action = "more windows in main";
      if (action == "main-count -1")      action = "fewer windows in main";
      if (action ~ /^main-location /) {
        sub(/^main-location /, "", action);
        action = "main area to the " action;
      }
      # wideriver vocabulary (ADR-0022) — same effects, same English, so the
      # sheet reads identically whichever generator is live.
      if (action == "--ratio +0.05")      action = "grow main area";
      if (action == "--ratio -0.05")      action = "shrink main area";
      if (action == "--count +1")         action = "more windows in main";
      if (action == "--count -1")         action = "fewer windows in main";
      if (action == "--layout-toggle")    action = "monocle ⇄ tiling";
      if (action ~ /^--layout /) {
        sub(/^--layout /, "", action);
        action = "main area to the " action;
      }
      if (action == "set-focused-tags all tags")        action = "show all tags";
      if (action == "toggle-focused-tags scratchpad tag") action = "toggle scratchpad";
      if (action == "set-view-tags scratchpad tag")     action = "send window to scratchpad";
      if (action == "move-view")          action = "move window (drag)";
      if (action == "resize-view")        action = "resize window (drag)";

      # Bare program names: say what the program IS here.
      if (action == "fuzzel")           action = "launcher";
      if (action == "kitty")            action = "terminal";
      if (action == "swaylock")         action = "lock screen";
      if (action == "wlogout")          action = "power menu";
      if (action ~ /river-wallpaper/)   action = "wallpaper picker";
      if (action ~ /river-cheatsheet/)  action = "this cheat sheet";
      if (action ~ /river-idle/)        action = "pause / resume auto-lock";

      # Padded to a column and separated by a rule.
      #
      # The padding is BEST EFFORT, not a guarantee: printf "%-Ns" pads by
      # characters, and several of these glyphs occupy two terminal cells, so
      # rows carrying icons sit a cell or two short. The │ is what actually
      # makes the two columns readable — without it, ragged padding looks
      # broken rather than approximate.
      printf "%s\t%-30s │ %s\n", section(action), combo, action;
    }' || true
  # `|| true`: under set -e + pipefail, a grep that matches nothing would
  # abort parse() here and take the hand-written tag rows below down with
  # it. An init with no bindings should produce a sheet with the four rows
  # that still apply, not an empty menu.

  # The per-tag bindings are generated by a shell loop in init, so the static
  # parse cannot see them. Described here rather than listed nine times, and
  # carrying their sort key and section by hand — they are tags rows.
  #
  # ALL FOUR binding families the loop generates. The Super+Shift+Ctrl row
  # was missing until 2026-08-24: the loop defines four, the sheet listed
  # three, and nothing about the sheet looked incomplete — same failure
  # class as the media key above, caught the same way.
  #
  # Super+0 is NOT here: it is a real `riverctl map` line and the parser
  # already picks it up. Listing it again produced two near-identical rows.
  printf '%s\t%s\n' \
    '󰌽 + 1..9'         'focus tag' \
    '󰌽 + ⇧ + 1..9'     'move window to tag' \
    '󰌽 + ⌃ + 1..9'     'toggle tag into view' \
    '󰌽 + ⇧ + ⌃ + 1..9' 'toggle tag on window' \
  | awk -F'\t' '{ printf "3\ttags\t%-30s │ %s\n", $1, $2 }'
}

# Stable numeric sort keeps each section's rows in config order — the order
# the init file tells its own story in — rather than re-alphabetising them.
# The final awk turns section changes into header rows; fuzzel renders them
# as entries, which is fine: they are captioned separators, selecting one
# does nothing (output is discarded), and typing still filters straight
# through to the real rows.
parse \
  | sort -s -t'	' -k1,1n \
  | awk -F'\t' '
      $2 != prev {
        line = "── " $2 " "
        while (length(line) < 50) line = line "─"
        print line
        prev = $2
      }
      { print $3 }
    ' \
  | fuzzel --dmenu --prompt '󰌌 keys ❯ ' --lines 24 --width 64 >/dev/null 2>&1 || true
