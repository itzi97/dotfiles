#!/usr/bin/env bash
#
# river-cheatsheet — searchable keybind reference, parsed from the live config.
#
# Bound to Super+Shift+slash (i.e. Super+?) in config/river/init.
#
# It READS ~/.config/river/init rather than maintaining its own list. A cheat
# sheet that is a second copy of the bindings is a cheat sheet that lies within
# a fortnight — the same two-sources-of-truth problem as ~/Applications vs
# ~/AppImages, or the README status block that went stale in three weeks.
#
# fuzzel's dmenu mode gives a filter box for free, which is what you actually
# want: "what was the screenshot one" is a search, not a scroll.

set -euo pipefail

INIT="${XDG_CONFIG_HOME:-$HOME/.config}/river/init"
[[ -r "$INIT" ]] || { echo "no river init at $INIT" >&2; exit 1; }

parse() {
  # Static `riverctl map` lines. Fields: mode, modifiers, key, action...
  # Field 1 is the MODIFIER set, field 2 is the key, the rest is the action.
  # Treating field 1 as the key shifts every line by one and produces a cheat
  # sheet that is confidently wrong — caught in testing, 2026-08-23.
  grep -E '^riverctl map(-pointer)? +(normal|locked)' "$INIT" \
  | sed -E '
      s/^riverctl map(-pointer)? +(normal|locked) +//;
      s/"\$mod"/Super/g;
    ' \
  | awk '{
      mods = $1; key = $2; $1 = ""; $2 = "";
      combo = (mods == "None") ? key : mods "+" key;

      action = $0;
      gsub(/^ +/, "", action);
      gsub(/^spawn +/, "", action);
      gsub(/send-layout-cmd rivertile /, "", action);
      gsub(/"/, "", action);
      gsub(/'\''/, "", action);
      gsub(/ +#.*$/, "", action);

      # Shell variables the config uses; expand them to something readable
      # rather than showing a raw $name in a reference document.
      gsub(/\$scratch_tag/, "scratchpad tag", action);
      gsub(/\$all_tags/,    "all tags",       action);

      # Long shell pipelines are noise in a cheat sheet; name them instead.
      if (action ~ /cliphist/) action = "clipboard history";
      if (action ~ /grim.*swappy/) action = "screenshot region → annotate";
      if (action ~ /grim.*wl-copy/) action = "screenshot region → clipboard";
      if (action ~ /grim ~\/Pictures/) action = "screenshot screen → file";
      if (action ~ /wpctl set-volume.*%\+/) action = "volume up";
      if (action ~ /wpctl set-volume.*%-/) action = "volume down";
      if (action ~ /wpctl set-mute @DEFAULT_AUDIO_SINK/) action = "mute";
      if (action ~ /wpctl set-mute @DEFAULT_AUDIO_SOURCE/) action = "mic mute";
      if (action ~ /brightnessctl set 5%\+/) action = "brightness up";
      if (action ~ /brightnessctl set 5%-/) action = "brightness down";

      printf "%-26s  %s\n", combo, action;
    }'

  # The per-tag bindings are generated by a shell loop in init, so grep cannot
  # see them. Described here rather than listed nine times.
  cat <<'TAGS'
Super+1..9                  focus tag
Super+Shift+1..9            move window to tag
Super+Control+1..9          toggle tag into view
Super+0                     show all tags
TAGS
}

parse \
  | sort \
  | fuzzel --dmenu --prompt 'keys ❯ ' --lines 20 --width 60 >/dev/null 2>&1 || true
