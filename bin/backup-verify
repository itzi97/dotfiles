#!/usr/bin/env bash
#
# backup-verify — prove the backup can actually be restored.
# ADR-0014: a backup that has never been restored is a hypothesis, exactly
# like a bootstrap.sh that has never been run on a clean machine.
#
# Checks repo integrity, then restores one real file at random and diffs it
# against the original. Run monthly by backup-verify.timer.

set -Eeuo pipefail

REPO="${RESTIC_REPOSITORY:-/mnt/backup-local/restic}"
PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-$HOME/.config/restic/password}"

# Must match backup-local's tag derivation EXACTLY, including the off-site
# suffix. The repo can hold snapshots from more than one machine, and verifying
# the wrong host's snapshot against this host's files would fail for the most
# confusing possible reason.
#
# The suffix is not optional: backup-local tags off-site snapshots
# "<host>-offsite" so that `restic forget --prune` cannot apply one machine's
# retention policy to another's snapshots. Without the same branch here, a
# verification run against the off-site repo would search for tag "thinkpad",
# find nothing, and die claiming it could not read the latest snapshot — a
# false failure on a healthy backup. Added 2026-08-24, alongside the
# backup-local fix that created the mismatch.
TAG="${RESTIC_TAG:-$(hostname -s 2>/dev/null || echo unknown)}"
[[ "${RESTIC_OFFSITE:-0}" == "1" ]] && TAG="${TAG}-offsite"

info() { printf '\033[36m==>\033[0m %s\n' "$*"; }
die()  {
  printf '\033[31mbackup VERIFY FAILED:\033[0m %s\n' "$*" >&2
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -u critical "Backup verification failed" "$*" || true
  exit 1
}
trap 'die "unexpected error on line $LINENO"' ERR

export RESTIC_REPOSITORY="$REPO"
export RESTIC_PASSWORD_FILE="$PASSWORD_FILE"

# Local repos only — same reasoning as backup-local: `mountpoint` on
# "sftp:hetzner-box:/home/restic/thinkpad" is meaningless and would kill the
# off-site verification run before it started. Off-site snapshots need
# verifying at least as much as local ones; ADR-0017's whole argument is that
# the remote copy is the one that survives the flat burning down.
case "$REPO" in
  /*|./*|../*)
    mountpoint -q "$(dirname "$REPO")" || die "$(dirname "$REPO") is not mounted"
    ;;
  *)
    info "remote repository (${REPO%%:*}) — the mountpoint check does not apply"
    ;;
esac

info "checking repository structure"
restic check

# --read-data-subset spot-checks actual pack contents rather than just the
# index. 5% monthly means the whole repo is covered roughly twice a year
# without ever costing a full read.
info "spot-checking 5% of pack data"
restic check --read-data-subset=5%

info "picking a file to restore"
target="$(mktemp -d)"
trap 'rm -rf "$target"' EXIT

# --- choosing a file that can give a MEANINGFUL answer ----------------------
#
# The comparison below is restored-copy vs live-file. That only proves anything
# if the live file hasn't changed since the snapshot was taken — otherwise a
# perfectly good backup reports "restored file DIFFERS" and fires a critical
# notification.
#
# The original version picked any file at random. `~/.config` and `~/.var/app`
# are in the backup set and are full of files that mutate constantly, so on a
# monthly timer this would have raised false alarms until it got ignored —
# which is the one failure mode that makes a verification check worthless.
#
# Two filters, both necessary:
#   1. Only stable trees. Documents/Pictures/Videos/Music/work are things I
#      write deliberately, not things a program rewrites in the background.
#   2. Only files whose mtime predates the snapshot. Belt and braces: even in
#      a stable tree, a file edited an hour ago would differ legitimately.
command -v jq >/dev/null 2>&1 || die "jq is required (packages/common.txt)"

snap_epoch="$(restic snapshots --tag "$TAG" --latest 1 --json 2>/dev/null \
              | jq -r '.[0].time' | xargs -I{} date -d {} +%s 2>/dev/null || true)"
[[ -n "$snap_epoch" ]] || die "could not read the timestamp of the latest '${TAG}' snapshot"

candidate=""
scanned=0
while read -r f; do
  # `scanned=$((scanned + 1))`, NOT `((scanned++))`.
  #
  # `((expr))` exits 1 when expr evaluates to 0, and post-increment returns the
  # OLD value — so on the first iteration `((scanned++))` evaluates to 0, exits
  # 1, and under `set -e` with the ERR trap above the script dies with
  # "unexpected error on line 73" and fires a critical notification.
  #
  # This script therefore never verified anything: it died on the first file it
  # looked at, every run, and the failure looked exactly like a real backup
  # problem. Found 2026-08-24 by running it against mocks.
  scanned=$((scanned + 1))
  [[ -f "$f" && -s "$f" ]] || continue
  case "$f" in
    "$HOME"/Documents/*|"$HOME"/Pictures/*|"$HOME"/Videos/*|"$HOME"/Music/*|"$HOME"/work/*) ;;
    *) continue ;;
  esac
  (( $(stat -c %Y "$f" 2>/dev/null || echo 0) <= snap_epoch )) || continue
  candidate="$f"; break
done < <(restic ls --tag "$TAG" latest 2>/dev/null | grep '^/' | shuf)

# No candidate is NOT a pass. It means this run proved nothing, and saying so
# is the whole point of the script.
[[ -n "$candidate" ]] || die "no unchanged file in a stable tree found among ${scanned} paths — verification proved nothing"

info "restoring: ${candidate}"
restic restore --tag "$TAG" latest --include "$candidate" --target "$target" >/dev/null

restored="${target}${candidate}"
[[ -f "$restored" ]] || die "restore produced no file at ${restored}"

if cmp -s "$restored" "$candidate"; then
  info "verified: restored copy is byte-identical to the original"
else
  die "restored file DIFFERS from the original: ${candidate}"
fi

info "verification passed"
