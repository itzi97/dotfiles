#!/usr/bin/env bash
#
# river-wallpaper — pick a wallpaper from a menu, apply it, and remember it.
#
#   river-wallpaper           # menu
#   river-wallpaper --restore # re-apply the saved one (called from river init)
#
# Bound to Super+w in config/river/init.
#
# The choice is persisted to XDG_STATE_HOME, not to the dotfiles repo: it is
# per-machine, changes often, and is exactly the kind of mutable state that
# 03-conventions/filesystem-layout.md keeps out of config. The repo stores the
# mechanism; the machine stores the choice.

set -euo pipefail

# Two sources, deliberately:
#
#   ~/Pictures/Wallpapers        images I chose and want kept. ~/Pictures is a
#                                Nextcloud sync pair, so anything here goes to
#                                Hetzner — fine for a handful, wrong for a
#                                cloned collection of several hundred.
#
#   ~/.local/share/wallpapers    bulk collections cloned from git. Not synced,
#                                not backed up, and correctly so: it is a
#                                `git clone` away from being recreated.
#
# Override either with WALLPAPER_DIRS="dir1:dir2".
WALLPAPER_DIRS="${WALLPAPER_DIRS:-$HOME/Pictures/Wallpapers:$HOME/.local/share/wallpapers}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/river"
STATE_FILE="${STATE_DIR}/wallpaper"

mkdir -p "$STATE_DIR"
IFS=':' read -r -a _dirs <<< "$WALLPAPER_DIRS"
mkdir -p "${_dirs[0]}"

apply() {
  local img="$1"
  [[ -f "$img" ]] || return 1
  # One swaybg at a time. Without the kill you stack instances and the old one
  # keeps painting underneath — invisible, but it never exits.
  pkill -x swaybg 2>/dev/null || true
  swaybg -i "$img" -m fill >/dev/null 2>&1 &
  printf '%s\n' "$img" > "$STATE_FILE"
}

# --restore: used at session start. Silent, and never fatal — a missing
# wallpaper must not take the session down with it.
if [[ "${1:-}" == "--restore" ]]; then
  [[ -r "$STATE_FILE" ]] || exit 0
  saved="$(cat "$STATE_FILE")"
  apply "$saved" || true
  exit 0
fi

existing=()
for d in "${_dirs[@]}"; do [[ -d "$d" ]] && existing+=("$d"); done

# -maxdepth 4: collections organise by category, sometimes nested.
# `-not -path '*/light/*'` skips the light-theme variants that gruvbox
# collections ship alongside the dark ones — this is a dark session and a
# light wallpaper in the menu is only ever a mis-click.
mapfile -t images < <(
  ((${#existing[@]})) && find "${existing[@]}" -maxdepth 4 -type f \
    -not -path '*/.git/*' -not -path '*/light/*' \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) | sort
)

if ((${#images[@]} == 0)); then
  # Say where to put them rather than failing silently with an empty menu.
  notify-send "No wallpapers found" "Looked in: ${WALLPAPER_DIRS//:/, }" 2>/dev/null \
    || echo "No wallpapers in ${WALLPAPER_DIRS//:/, }" >&2
  exit 1
fi

# Menu shows "category/filename" rather than a bare basename — with a few
# hundred images from a collection, the folder is most of the information.
#
# ONLY the label is sent to fuzzel, and the path is recovered from a lookup
# table afterwards.
#
# The previous version piped "label<TAB>path" to fuzzel and pulled the path
# back with `cut -f2`. That works, but fuzzel displays the whole line: the tab
# renders as whitespace and every entry in the menu carried its full absolute
# path next to the label, which is the opposite of what the comment above
# claimed. Trimming the display needs `--with-nth`, which older fuzzel builds
# do not have, and this repo does not get to assume a flag it has not checked.
# A lookup table needs no flag at all.
declare -A _by_label=()
_labels=()
for p in "${images[@]}"; do
  # Label is the path RELATIVE TO ITS COLLECTION ROOT, not just the parent
  # directory. Gruvbox collections nest as <collection>/<variant>/<file>, so
  # the immediate parent is usually "dark" — which labelled two different
  # images from two different collections identically as "dark/forest.png" and
  # left the disambiguator to invent "(2)". Relative paths carry the collection
  # name, which is the part that tells them apart.
  label="$p"
  for d in "${existing[@]}"; do
    if [[ "$p" == "$d"/* ]]; then
      label="${p#"$d"/}"
      break
    fi
  done
  # Collections do repeat filenames across categories, and two identical
  # labels would make one image unselectable. Disambiguate rather than
  # silently dropping one.
  if [[ -n "${_by_label[$label]:-}" ]]; then
    n=2
    while [[ -n "${_by_label["${label} (${n})"]:-}" ]]; do n=$((n + 1)); done
    label="${label} (${n})"
  fi
  _by_label["$label"]="$p"
  _labels+=("$label")
done

# --- previews ---------------------------------------------------------------
# fuzzel's dmenu mode renders per-entry icons (rofi protocol: append
# \0icon\x1f<path> to a line), but only PNG/SVG — and feeding it raw 4K
# JPEGs would be wrong even if it could. So: a thumbnail cache. Each image
# gets a small PNG rendered once by ImageMagick and reused forever; the
# cache lives under XDG_CACHE (per-machine, disposable, like the collections
# themselves). Missing ImageMagick degrades to the old text-only menu —
# previews are a display upgrade, not a dependency of picking.
THUMBS="${XDG_CACHE_HOME:-$HOME/.cache}/river-wallpaper/thumbs"
MAGICK=""
command -v magick >/dev/null 2>&1 && MAGICK=magick
[[ -z "$MAGICK" ]] && command -v convert >/dev/null 2>&1 && MAGICK=convert

_entries_file="$(mktemp)"
trap 'rm -f "$_entries_file"' EXIT

if [[ -n "$MAGICK" ]]; then
  mkdir -p "$THUMBS"
  # Generate missing/stale thumbs in parallel. First run over a fresh
  # collection takes a while — say so rather than appearing hung.
  _todo="$(mktemp)"
  for _label in "${_labels[@]}"; do
    p="${_by_label[$_label]}"
    t="$THUMBS/$(printf '%s' "$p" | sha256sum | cut -c1-32).png"
    if [[ ! -f "$t" || "$p" -nt "$t" ]]; then
      printf '%s\0%s\0' "$p" "$t" >> "$_todo"
    fi
  done
  if [[ -s "$_todo" ]]; then
    n=$(( $(tr -cd '\0' < "$_todo" | wc -c) / 2 ))
    (( n > 20 )) && notify-send -a wallpaper -u low "Generating ${n} wallpaper previews…" 2>/dev/null || true
    # NUL-separated src/dst pairs — filenames stay arbitrary — consumed two
    # at a time; -P bounds the parallelism. -auto-orient honours EXIF.
    xargs -0 -n2 -P "$(nproc)" sh -c \
      "$MAGICK \"\$1\" -auto-orient -thumbnail 128x128^ -gravity center -extent 128x128 \"\$2\" 2>/dev/null" _ \
      < "$_todo" || true
  fi
  rm -f "$_todo"
  for _label in "${_labels[@]}"; do
    p="${_by_label[$_label]}"
    t="$THUMBS/$(printf '%s' "$p" | sha256sum | cut -c1-32).png"
    if [[ -f "$t" ]]; then
      printf '%s\0icon\x1f%s\n' "$_label" "$t" >> "$_entries_file"
    else
      printf '%s\n' "$_label" >> "$_entries_file"
    fi
  done
else
  printf '%s\n' "${_labels[@]}" > "$_entries_file"
fi

# Taller rows so the thumbnails are legible — but --line-height is probed
# rather than assumed, because a flag fuzzel doesn't know kills the menu.
_lh=()
fuzzel --help 2>&1 | grep -q -- '--line-height' && _lh=(--line-height=28)

# Picker convention (ADR-0021): "<glyph> <noun> ❯" prompt — same family as
# the cheat sheet and clipboard menus. 󰋩 is MDI image (F02E9), verified.
picked="$(fuzzel --dmenu --prompt '󰋩 wallpaper ❯ ' --lines 10 --width 64 \
    "${_lh[@]}" < "$_entries_file")" || picked=""

[[ -n "${picked:-}" ]] || exit 0
choice="${_by_label[$picked]:-}"
# An empty lookup means fuzzel returned something that was not on the list —
# it echoes free text when nothing matches. Treat it as a cancel, not as a
# path, or `apply` gets an empty string and the state file gets truncated.
[[ -n "$choice" ]] || exit 0
apply "$choice"
