{
    "label": "lock",
    "action": "swaylock",
    "text": "Lock",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "riverctl exit",
    "text": "Log out",
    "keybind": "e"
}
{
    "label": "suspend",
    "action": "swaylock -f; systemctl suspend",
    "text": "Suspend",
    "keybind": "s"
}
{
    "label": "hibernate",
    "action": "swaylock -f; systemctl hibernate",
    "text": "Hibernate",
    "keybind": "h"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shut down",
    "keybind": "p"
}
