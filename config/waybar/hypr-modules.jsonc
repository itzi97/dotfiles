// ~/.config/waybar/hypr-modules.jsonc
//
// MODULE DEFINITIONS ONLY, for the Hyprland session's bar. This file defines
// what every module IS; it deliberately declares no bar and no layout — no
// `layer`, `position`, `height`, `spacing` or `modules-*`.
//
// Those live in the THEME, because arranging the bar differently is half of
// what makes two themes feel like two systems rather than two palettes:
//   ~/.config/hypr/themes/<name>/waybar.jsonc
// which pulls this file in with waybar's `include` key. Merge order is
// including-file first, so a theme may override any module defined here
// simply by redeclaring it — see neon-sprawl's clock.
//
// WAS hyprland.jsonc UNTIL 2026-08-26. Renamed when the bar was themed
// (ADR-0026): a file called hyprland.jsonc that can no longer start a bar on
// its own is a trap for whoever reads the exec-once line next.
//
// config.jsonc — the RIVER bar — is untouched and stays a standalone config
// with its own copy of these modules. That fork is deliberate: river is a
// sunset candidate (ADR-0023) and is pinned to the gruvbox design forever, so
// the old "edit both or it's a bug" rule no longer applies between these two
// files. It still applies between this file and the themes.
{
  "hyprland/workspaces": {
    // Nine fixed workspaces, mirroring the river bar's nine tags — the
    // special (scratchpad) workspace is deliberately not shown, same as
    // river's tag 10: it is an overlay, not a place you go.
    "format": "{id}",
    "persistent-workspaces": { "*": 9 },
    "on-click": "activate"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    // Only this output's windows, and only the visible workspace — otherwise
    // the bar fills with every window you have open anywhere.
    "all-outputs": false,
    "active-first": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "tooltip": false
  },

  "custom/media-prev": {
    // Visible transport keys flanking the readout (second-feedback: one
    // button was not a controller). hide-empty-text drops them when no
    // player is up, so the center well vanishes as a unit.
    "exec": "playerctl status >/dev/null 2>&1 && echo 󰒮 || true",
    "interval": 3,
    "format": "{}",
    "hide-empty-text": true,
    // Routed through bin/waybar-media so the key acts on the player the bar
    // is SHOWING — a bare `playerctl previous` acts on whichever player last
    // became active. Same change in config.jsonc.
    "on-click": "$HOME/.local/bin/waybar-media prev",
    "tooltip": false
  },

  "custom/media-next": {
    "exec": "playerctl status >/dev/null 2>&1 && echo 󰒭 || true",
    "interval": 3,
    "format": "{}",
    "hide-empty-text": true,
    "on-click": "$HOME/.local/bin/waybar-media next",
    "tooltip": false
  },

  // THE NOW-PLAYING READOUT — a progress bar that says which app is playing,
  // opening on hover to the cover art and the track name. Replaces the
  // built-in `mpris` module, which can expose neither a position-dependent
  // CSS class nor an image on hover. The full reasoning (and the upstream
  // issue numbers) lives in config.jsonc; these four blocks are deliberately
  // identical to the ones there.
  "group/media": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 250,
      "children-class": "media-drawer",
      "transition-left-to-right": true
    },
    // ORDER IS LOAD-BEARING: the first module is the always-visible "group
    // leader"; the rest are what the drawer reveals.
    "modules": ["custom/media", "image#media-art", "custom/media-title"]
  },

  "custom/media": {
    "exec": "$HOME/.local/bin/waybar-media bar",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "hide-empty-text": true,
    "on-click": "$HOME/.local/bin/waybar-media toggle",
    "on-click-middle": "$HOME/.local/bin/waybar-media prev",
    "on-click-right": "$HOME/.local/bin/waybar-media next",
    "on-scroll-up": "$HOME/.local/bin/waybar-media seek-forward",
    "on-scroll-down": "$HOME/.local/bin/waybar-media seek-back"
  },

  "image#media-art": {
    // `exec` and NOT `path`: setting both silently disables exec
    // (Alexays/Waybar#2085). The script never blocks — see config.jsonc.
    "exec": "$HOME/.local/bin/waybar-media art",
    "size": 22,
    "interval": 2,
    "tooltip": false
  },

  "custom/media-title": {
    "exec": "$HOME/.local/bin/waybar-media title",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "max-length": 45,
    "hide-empty-text": true,
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    // Pressure states, same semantics as battery's: orange = attend soon,
    // red = act now. Ambient gray the rest of the time.
    "states": { "warning": 80, "critical": 92 },
    "tooltip": true,
    "on-click": "kitty --class floatterm -e btop"
  },

  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    "states": { "warning": 80, "critical": 92 },
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G   swap {swapPercentage}%",
    "on-click": "kitty --class floatterm -e btop"
  },

  "temperature": {
    "interval": 10,
    // No thermal-zone pinned — same reasoning as config.jsonc: zone numbers
    // are machine- and boot-specific; pin in local/thinkpad/ if ever needed.
    "critical-threshold": 82,
    "format": "{icon} {temperatureC}°C",
    "format-critical": "󰸁 {temperatureC}°C",
    "format-icons": ["󰜗", "󰔏", "󰸁"]
  },

  "custom/idle": {
    // bin/river-idle is compositor-agnostic (swayidle + ext-idle-notify,
    // which Hyprland implements) and is the SINGLE source of idle truth for
    // both sessions — see the module comment in config.jsonc.
    "exec": "$HOME/.local/bin/river-idle waybar",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "on-click": "$HOME/.local/bin/river-idle toggle",
    "on-click-right": "$HOME/.local/bin/river-idle stop 0"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "custom/mic": {
    // Whether the microphone is live or muted, from the same script the
    // mute key uses — bar and key cannot disagree. Live = fg, muted =
    // receded gray, mirroring the volume module's pattern.
    "exec": "$HOME/.local/bin/osd mic-status",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "on-click": "$HOME/.local/bin/osd mic-mute"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{node_name}"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}  ({power}W)"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󰂚<span foreground='#fb4934'><sup></sup></span>",
      "none": "󰂚",
      "dnd-notification": "󰂛<span foreground='#fb4934'><sup></sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='#fb4934'><sup></sup></span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛<span foreground='#fb4934'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":  "<span color='#ebdbb2'><b>{}</b></span>",
        "days":    "<span color='#ebdbb2'>{}</span>",
        "weeks":   "<span color='#928374'>W{}</span>",
        "weekdays":"<span color='#a89984'><b>{}</b></span>",
        "today":   "<span color='#d79921'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Session menu (Super+Shift+P)",
    "on-click": "wlogout -b 3 -s $HOME/.local/state/hypr-theme/live/wlogout.css"
  }
}
