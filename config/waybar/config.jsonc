// ~/.config/waybar/config.jsonc
//
// Bar for the river session. Left: tags, window icons, focused title.
// Right: tray, audio, brightness, battery, notifications, clock.
//
// Icons are Nerd Font glyphs. A Nerd Font is already installed (eza's --icons
// renders correctly), and style.css falls back to plain JetBrains Mono if that
// ever stops being true — you would get boxes, not a broken bar.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,

  // wlr/taskbar is here because river/window is TEXT ONLY — waybar has no
  // app-icon lookup for it. Wanting "the focused title with an icon" needs
  // both modules: taskbar supplies icons for the windows on this tag,
  // river/window supplies the title of whichever is focused.
  "modules-left": ["river/tags", "wlr/taskbar", "river/window"],
  "modules-center": [],
  // Ordered by how often you look at it, left to right: machine load first
  // (glanceable, ignorable), then the things you interact with, then the
  // clock, then power. The power button is last because it is the only one
  // where a mis-click costs you unsaved work.
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "custom/idle",
    "tray",
    "wireplumber",
    "backlight",
    "battery",
    "custom/notification",
    "clock",
    "custom/power"
  ],

  "river/tags": {
    // Nine tags. Tag 10 exists but is the scratchpad (see config/river/init)
    // and is deliberately not shown — it is an overlay, not a place you go.
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
    "set-tags": [1, 2, 4, 8, 16, 32, 64, 128, 256]
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    // Only this output's windows, and only the visible tag — otherwise the
    // bar fills with every window you have open anywhere.
    "all-outputs": false,
    "active-first": true
  },

  "river/window": {
    "format": "{}",
    "max-length": 60,
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    "tooltip": true,
    // btop rather than top: it is already installed and readable at a glance,
    // which is the point of clicking a load indicator.
    "on-click": "kitty --class floatterm -e btop"
  },

  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    // Absolute numbers belong in the tooltip. 62% means nothing without
    // knowing the machine has 16G; "9.9G/16.0G" answers it directly.
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G   swap {swapPercentage}%",
    "on-click": "kitty --class floatterm -e btop"
  },

  "temperature": {
    "interval": 10,
    // NO thermal-zone or hwmon-path set, deliberately.
    //
    // Both are machine-specific: thermal zone 0 is the CPU package on some
    // ThinkPads and the ACPI skin sensor on others, and hwmon numbering moves
    // between boots because it depends on driver probe order. Pinning either
    // one from a dotfiles repo gives a number that is confidently wrong on
    // any other machine, which is worse than no number.
    //
    // Left unset, waybar picks the first available zone. If it reports
    // something implausible, find the right one and pin it in
    // local/thinkpad/ — not here:
    //   for z in /sys/class/thermal/thermal_zone*; do \
    //     printf '%s %s %s\n' "$z" "$(cat $z/type)" "$(cat $z/temp)"; done
    "critical-threshold": 82,
    "format": "{icon} {temperatureC}°C",
    "format-critical": "󰸁 {temperatureC}°C",
    "format-icons": ["󰜗", "󰔏", "󰸁"]
  },

  "custom/idle": {
    // NOT waybar's built-in `idle_inhibitor` module, deliberately.
    //
    // That module speaks zwp_idle_inhibit_manager_v1, which asks the
    // COMPOSITOR not to report the seat as idle. Whether that reaches swayidle
    // depends on river implementing the protocol and swayidle honouring it —
    // a chain of assumptions, and "the screen locked mid-presentation" is a
    // poor way to discover a broken link. bin/river-idle stops swayidle
    // itself, which cannot silently fail to work.
    //
    // It also gives three things the built-in cannot: a keybinding
    // (Super+Shift+I), an automatic expiry so a pause cannot be left on for
    // days, and a distinct BROKEN state for "swayidle isn't running and nobody
    // asked for that" — which the built-in would render identically to
    // "everything is fine".
    "exec": "$HOME/.local/bin/river-idle waybar",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "on-click": "$HOME/.local/bin/river-idle toggle",
    // Right-click pauses indefinitely. Deliberately the awkward one.
    "on-click-right": "$HOME/.local/bin/river-idle stop 0"
  },

  "tray": {
    // This is what makes nm-applet and blueman-applet reachable. Without a
    // tray module they run invisibly and you cannot pick a wifi network.
    "icon-size": 16,
    "spacing": 10
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{node_name}"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
    // Time-to-empty in the tooltip. On a laptop that leaves the house this is
    // the number that actually matters, and it is worth a hover not a glance.
    "tooltip-format": "{timeTo}  ({power}W)"
  },

  "custom/notification": {
    "tooltip": false,
    // "{text}", not "{}" — waybar rejects mixing manual and automatic
    // argument indexing and drops the module with:
    //   error: custom/notification: mixing manual and automatic argument
    //   indexing is no longer supported
    // The bar still renders, so the only symptom is a silently missing
    // notification indicator (2026-08-23).
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󰂚<span foreground='#fb4934'><sup></sup></span>",
      "none": "󰂚",
      "dnd-notification": "󰂛<span foreground='#fb4934'><sup></sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='#fb4934'><sup></sup></span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛<span foreground='#fb4934'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",        // open the notification panel
    "on-click-right": "swaync-client -d -sw",  // toggle do-not-disturb
    "escape": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    // Click to expand the calendar, scroll to change month.
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":  "<span color='#ebdbb2'><b>{}</b></span>",
        "days":    "<span color='#ebdbb2'>{}</span>",
        "weeks":   "<span color='#83a598'><b>W{}</b></span>",
        "weekdays":"<span color='#d79921'><b>{}</b></span>",
        "today":   "<span color='#fe8019'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/power": {
    // Same wlogout menu as Super+Shift+P, for when the mouse is already up
    // here. Left-click only — no scroll or right-click action, because an
    // accidental brush against the corner of the screen should not offer to
    // shut the machine down.
    "format": "󰐥",
    "tooltip-format": "Session menu (Super+Shift+P)",
    "on-click": "wlogout -b 3"
  }
}
