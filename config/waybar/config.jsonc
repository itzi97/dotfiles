// ~/.config/waybar/config.jsonc
//
// Bar for the river session. Left: tags, window icons, focused title.
// Right: tray, audio, brightness, battery, notifications, clock.
//
// Icons are Nerd Font glyphs. A Nerd Font is already installed (eza's --icons
// renders correctly), and style.css falls back to plain JetBrains Mono if that
// ever stops being true — you would get boxes, not a broken bar.
{
  "layer": "top",
  "position": "top",
  // 38 with 6px well margins: at 34/4px the wells crowded the bar edges
  // (second-feedback, 2026-08-25).
  "height": 38,
  "spacing": 6,

  // wlr/taskbar is here because river/window is TEXT ONLY — waybar has no
  // app-icon lookup for it. Wanting "the focused title with an icon" needs
  // both modules: taskbar supplies icons for the windows on this tag,
  // river/window supplies the title of whichever is focused.
  "modules-left": ["river/tags", "wlr/taskbar", "river/window"],
  // The now-playing readout, dead center — Spotify, Firefox (YouTube), and
  // any real Navidrome client all speak MPRIS. Fuller controls with album
  // art live in the swaync control center's mpris widget (click the bell).
  "modules-center": ["custom/media-prev", "group/media", "custom/media-next"],
  // Ordered by how often you look at it, left to right: machine load first
  // (glanceable, ignorable), then the things you interact with, then the
  // clock, then power. The power button is last because it is the only one
  // where a mis-click costs you unsaved work.
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "custom/idle",
    "tray",
    "custom/mic",
    "wireplumber",
    "backlight",
    "battery",
    "custom/notification",
    "clock",
    "custom/power"
  ],

  "river/tags": {
    // Nine tags. Tag 10 exists but is the scratchpad (see config/river/init)
    // and is deliberately not shown — it is an overlay, not a place you go.
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
    "set-tags": [1, 2, 4, 8, 16, 32, 64, 128, 256]
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    // Only this output's windows, and only the visible tag — otherwise the
    // bar fills with every window you have open anywhere.
    "all-outputs": false,
    "active-first": true
  },

  "river/window": {
    "format": "{}",
    "max-length": 60,
    "tooltip": false
  },

  "custom/media-prev": {
    // Visible transport keys flanking the readout (second-feedback: one
    // button was not a controller). hide-empty-text drops them when no
    // player is up, so the center well vanishes as a unit.
    //
    // on-click routes through bin/waybar-media rather than calling playerctl
    // directly: a bare `playerctl previous` acts on whichever player last
    // became active, which is not necessarily the one the bar is showing.
    // These two buttons DID have that drift bug; the readout never did.
    "exec": "playerctl status >/dev/null 2>&1 && echo 󰒮 || true",
    "interval": 3,
    "format": "{}",
    "hide-empty-text": true,
    "on-click": "$HOME/.local/bin/waybar-media prev",
    "tooltip": false
  },

  "custom/media-next": {
    "exec": "playerctl status >/dev/null 2>&1 && echo 󰒭 || true",
    "interval": 3,
    "format": "{}",
    "hide-empty-text": true,
    "on-click": "$HOME/.local/bin/waybar-media next",
    "tooltip": false
  },

  // THE NOW-PLAYING READOUT. A progress bar that says WHICH APP is playing,
  // and opens on hover to show the cover art and the track name.
  //
  // This replaces the built-in `mpris` module, which could not do either
  // half. A progress bar needs a CSS class that tracks playback position, and
  // mpris only ever exposes #mpris.${player} and #mpris.${status} — only a
  // CUSTOM module can set its own class. And the hover preview cannot be a
  // tooltip at all: waybar tooltips are Pango, Pango has no image element
  // (Alexays/Waybar#1999), and custom modules have no on-enter hook (#523).
  //
  // `group` with `drawer` IS the hover mechanism waybar actually has. See
  // bin/waybar-media for the rest of the reasoning, including what a
  // "browser window preview" honestly resolves to for a YouTube tab.
  "group/media": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 250,
      "children-class": "media-drawer",
      "transition-left-to-right": true
    },
    // ORDER IS LOAD-BEARING. The first module is the drawer's "group leader"
    // and is the ONLY one always visible; the rest are revealed on hover.
    // Put anything else first and the bar becomes the thing that hides.
    "modules": ["custom/media", "image#media-art", "custom/media-title"]
  },

  "custom/media": {
    // interval 1 would track position more smoothly, but style.css quantises
    // the fill to 2% anyway — on a 3-minute track a step lands every ~3.6s,
    // so polling faster than 2s spends ThinkPad battery on frames that are
    // pixel-identical.
    "exec": "$HOME/.local/bin/waybar-media bar",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "hide-empty-text": true,
    "on-click": "$HOME/.local/bin/waybar-media toggle",
    "on-click-middle": "$HOME/.local/bin/waybar-media prev",
    "on-click-right": "$HOME/.local/bin/waybar-media next",
    "on-scroll-up": "$HOME/.local/bin/waybar-media seek-forward",
    "on-scroll-down": "$HOME/.local/bin/waybar-media seek-back"
  },

  "image#media-art": {
    // `exec` and NOT `path`. Setting both silently disables exec — "It will
    // only execute if the path is not set" — which is the entirety of
    // Alexays/Waybar#2085, where the cover never changed.
    //
    // The script never blocks: it returns art already in the cache and
    // downloads anything new in the background for the next tick. A curl
    // stalling on a captive portal here would freeze the whole bar, not just
    // this module.
    "exec": "$HOME/.local/bin/waybar-media art",
    "size": 22,
    "interval": 2,
    "tooltip": false
  },

  "custom/media-title": {
    // The track name that used to be the readout itself. It did not go away,
    // it moved to where you go looking for it — which is what buys the bar
    // back the ~400px the old "{artist} — {title}" scroll cost at all times.
    "exec": "$HOME/.local/bin/waybar-media title",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "max-length": 45,
    "hide-empty-text": true,
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    // Pressure states, same semantics as battery's: orange = attend soon,
    // red = act now. Ambient gray the rest of the time.
    "states": { "warning": 80, "critical": 92 },
    "tooltip": true,
    // btop rather than top: it is already installed and readable at a glance,
    // which is the point of clicking a load indicator.
    "on-click": "kitty --class floatterm -e btop"
  },

  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    "states": { "warning": 80, "critical": 92 },
    // Absolute numbers belong in the tooltip. 62% means nothing without
    // knowing the machine has 16G; "9.9G/16.0G" answers it directly.
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G   swap {swapPercentage}%",
    "on-click": "kitty --class floatterm -e btop"
  },

  "temperature": {
    "interval": 10,
    // NO thermal-zone or hwmon-path set, deliberately.
    //
    // Both are machine-specific: thermal zone 0 is the CPU package on some
    // ThinkPads and the ACPI skin sensor on others, and hwmon numbering moves
    // between boots because it depends on driver probe order. Pinning either
    // one from a dotfiles repo gives a number that is confidently wrong on
    // any other machine, which is worse than no number.
    //
    // Left unset, waybar picks the first available zone. If it reports
    // something implausible, find the right one and pin it in
    // local/thinkpad/ — not here:
    //   for z in /sys/class/thermal/thermal_zone*; do \
    //     printf '%s %s %s\n' "$z" "$(cat $z/type)" "$(cat $z/temp)"; done
    "critical-threshold": 82,
    "format": "{icon} {temperatureC}°C",
    "format-critical": "󰸁 {temperatureC}°C",
    "format-icons": ["󰜗", "󰔏", "󰸁"]
  },

  "custom/idle": {
    // NOT waybar's built-in `idle_inhibitor` module, deliberately.
    //
    // That module speaks zwp_idle_inhibit_manager_v1, which asks the
    // COMPOSITOR not to report the seat as idle. Whether that reaches swayidle
    // depends on river implementing the protocol and swayidle honouring it —
    // a chain of assumptions, and "the screen locked mid-presentation" is a
    // poor way to discover a broken link. bin/river-idle stops swayidle
    // itself, which cannot silently fail to work.
    //
    // It also gives three things the built-in cannot: a keybinding
    // (Super+Shift+I), an automatic expiry so a pause cannot be left on for
    // days, and a distinct BROKEN state for "swayidle isn't running and nobody
    // asked for that" — which the built-in would render identically to
    // "everything is fine".
    "exec": "$HOME/.local/bin/river-idle waybar",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "on-click": "$HOME/.local/bin/river-idle toggle",
    // Right-click pauses indefinitely. Deliberately the awkward one.
    "on-click-right": "$HOME/.local/bin/river-idle stop 0"
  },

  "tray": {
    // This is what makes nm-applet and blueman-applet reachable. Without a
    // tray module they run invisibly and you cannot pick a wifi network.
    "icon-size": 16,
    "spacing": 6    // the bar's element gap; the tray had a private one
  },

  "custom/mic": {
    // Whether the microphone is live or muted, from the same script the
    // mute key uses — bar and key cannot disagree. Live = fg, muted =
    // receded gray, mirroring the volume module's pattern.
    "exec": "$HOME/.local/bin/osd mic-status",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "on-click": "$HOME/.local/bin/osd mic-mute"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{node_name}"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
    // Time-to-empty in the tooltip. On a laptop that leaves the house this is
    // the number that actually matters, and it is worth a hover not a glance.
    "tooltip-format": "{timeTo}  ({power}W)"
  },

  "custom/notification": {
    "tooltip": false,
    // "{text}", not "{}" — waybar rejects mixing manual and automatic
    // argument indexing and drops the module with:
    //   error: custom/notification: mixing manual and automatic argument
    //   indexing is no longer supported
    // The bar still renders, so the only symptom is a silently missing
    // notification indicator (2026-08-23).
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󰂚<span foreground='#fb4934'><sup></sup></span>",
      "none": "󰂚",
      "dnd-notification": "󰂛<span foreground='#fb4934'><sup></sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='#fb4934'><sup></sup></span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛<span foreground='#fb4934'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",        // open the notification panel
    "on-click-right": "swaync-client -d -sw",  // toggle do-not-disturb
    "escape": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    // Click to expand the calendar, scroll to change month.
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      // Colour grammar (ADR-0021): "today" is the current thing, so it takes
      // the accent. Weekday/week headers are chrome and recede — the old
      // blue/orange gave the calendar three hues that existed nowhere else
      // in the session and meant nothing in it.
      "format": {
        "months":  "<span color='#ebdbb2'><b>{}</b></span>",
        "days":    "<span color='#ebdbb2'>{}</span>",
        "weeks":   "<span color='#928374'>W{}</span>",
        "weekdays":"<span color='#a89984'><b>{}</b></span>",
        "today":   "<span color='#d79921'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/power": {
    // Same wlogout menu as Super+Shift+P, for when the mouse is already up
    // here. Left-click only — no scroll or right-click action, because an
    // accidental brush against the corner of the screen should not offer to
    // shut the machine down.
    "format": "󰐥",
    "tooltip-format": "Session menu (Super+Shift+P)",
    "on-click": "wlogout -b 3"
  }
}
