# ~/.config/systemd/user/backup-verify.timer
# Why: monthly proof that a restore works. Failure here is a real failure.
# Added: 2026-08
# Machine: desktop
[Unit]
Description=Monthly restic verification

[Timer]
OnCalendar=*-*-01 21:00:00
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
