# Interactive shells only.
case $- in *i*) ;; *) return ;; esac

. "$HOME/.config/shell/exports.sh"
. "$HOME/.config/shell/aliases.sh"

# --- prompt (starship) ---------------------------------------------------
# BEFORE the fish handoff on purpose: this is what the rescue shell looks like.
# ADR-0010 drops me into bash when fish is broken, which is precisely when I
# still want a prompt telling me the branch, the exit code and where I am.
command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"

# --- hand off to fish -----------------------------------------------------
# bash stays the LOGIN shell so /etc/profile and /etc/profile.d/*.sh are still
# read (fish cannot read them — that's the whole reason for this). fish is the
# shell I actually type in. See ADR-0010.
#
# Placed last, so everything above is already in the environment fish inherits.
#
# The guard is EXPORTED: typing `bash` from inside fish must stay bash, or the
# escape hatch loops straight back into fish and stops being an escape hatch.
#
# Note: a bare TTY login reads ~/.bash_profile, not ~/.bashrc, so it lands in
# bash. That is deliberate — it's the rescue shell for when fish is broken or
# not installed.
if [ -z "${FISH_LAUNCHED:-}" ] && command -v fish >/dev/null 2>&1; then
    export FISH_LAUNCHED=1
    exec fish
fi
