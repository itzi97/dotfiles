#!/usr/bin/env bash
#
# ~/.config/river/init  (linked from ~/.dotfiles/config/river/init)
#
# river runs this once at startup. It is a plain shell script — every line is
# a `riverctl` call — so it is live-editable: change it, then `riverctl` the
# single command you changed, or log out and back in.
#
# CONTEXT (read this before changing anything structural)
#
#   river is a SECONDARY session. Plasma remains the default in SDDM, on
#   purpose: river has no Fedora maintainer, no fallback mode, and this config
#   is young. ADR-0002 established that pattern for Hyprland on the desktop;
#   principle #2 requires it on the college machine. If you ever set river as
#   the SDDM default, this stops being a low-risk experiment.
#
#   river composites and nothing else. Every autostart at the bottom of this
#   file replaces something Plasma was quietly doing. That list is the honest
#   cost of a minimal compositor.
#
# Package set: packages/bundles/river.txt

# NO `set -e` HERE. This is deliberate and it is the most important line in
# the file.
#
# 2026-08-23: the first version had `set -euo pipefail`. A single riverctl
# command that river 0.4.8 doesn't recognise then aborted the whole init —
# no keybindings, no background, no waybar, no autostart. The result is a
# black screen with no way to interact with it, and the only recovery is a
# TTY or the power button.
#
# A compositor init is exactly the case where partial success beats failure:
# a session missing one binding is usable, a session missing everything is
# not. Every command below is allowed to fail on its own.
#
# `set -u` is kept — an unset variable here is a typo, not a version
# difference, and it fails at the point of use rather than silently binding
# something to nothing.
set -u

# Log what didn't work, so a missing feature is diagnosable without a bisect.
# Read it with:  cat ~/.local/state/river/init.log
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/river"
mkdir -p "$STATE_DIR"
LOG="${STATE_DIR}/init.log"
: > "$LOG"

# Wrapper for anything river-version-dependent. Runs the command, records a
# failure, carries on.
try() {
  if ! "$@" 2>>"$LOG"; then
    printf 'FAILED: %s\n' "$*" >> "$LOG"
  fi
}

mod="Super"

# --- environment ------------------------------------------------------------
#
# READ THIS BEFORE ADDING AN `export` HERE. It will not do what you expect.
#
# An earlier version of this file exported PATH, QT_QPA_PLATFORMTHEME,
# MOZ_ENABLE_WAYLAND, ELECTRON_OZONE_PLATFORM_HINT and friends, with a comment
# claiming "set before anything spawns, or the children inherit the wrong
# values". That comment was wrong, and measurably so. Inside a river session:
#
#   $ echo "QT_QPA_PLATFORMTHEME=[$QT_QPA_PLATFORMTHEME]"
#   QT_QPA_PLATFORMTHEME=[]
#   $ echo "MOZ_ENABLE_WAYLAND=[$MOZ_ENABLE_WAYLAND]"
#   MOZ_ENABLE_WAYLAND=[]
#
# WHY. river executes this file as a CHILD process. `riverctl map ... spawn X`
# does not run X from this script — it asks river, the PARENT, to spawn it.
# X therefore inherits *river's* environment, which a child cannot modify.
# Exports here reach only the processes this file starts itself: the autostart
# block at the bottom. Nothing launched from a keybinding, from fuzzel, or from
# an app launched by another app sees them.
#
# The same mistake explains a bug that was blamed on PATH. `spawn
# river-cheatsheet` failed silently while running river-cheatsheet in a
# terminal worked — attributed to the display manager not reading profile
# files, "fixed" by exporting PATH here, and it kept failing. It was never a
# PATH-resolution problem this file could solve. The bindings now use absolute
# paths (see the utilities section) and the exports are gone.
#
# WHERE THESE BELONG: bin/river-session, the wrapper that sets them and then
# `exec river`. Setting them before river starts is the only place they can
# reach river's children. Verified empty here on 2026-08-23.
#
# XDG_CURRENT_DESKTOP is deliberately NOT set either. river-classic's own
# session file already supplies it, and better than this file did:
#   /usr/share/wayland-sessions/river.desktop: DesktopNames=river;wlroots
# so the value in effect is `river;wlroots`, not the `river` this file used to
# force. That matters — `wlr.portal` declares `UseIn=wlroots;sway;...;river;`
# and the portal searches BOTH names for a config, so the two-name value is
# strictly more useful. Overriding it here narrowed it for no benefit.

# Portals and systemd user services need these to reach the session.
# Without this, screen sharing silently produces a black frame.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
fi

# The systemd user manager needs the SAME variables, separately.
#
# dbus-update-activation-environment --systemd populates the environment that
# D-BUS-ACTIVATED services get. It does NOT reach units systemd starts itself,
# and xdg-desktop-portal.service is ordered after graphical-session.target —
# a target river never reaches, because nothing tells systemd the graphical
# session has begun. The symptom is the portal failing to activate at all:
#
#   Could not activate remote peer 'org.freedesktop.portal.Desktop':
#   startup job failed
#
# which costs GTK4 dark mode, Flatpak file pickers and — the one that matters
# on this machine — screen sharing. Observed 2026-08-23.
#
# river-session.target (config/systemd/river-session.target) BindsTo
# graphical-session.target, so starting it starts the graphical session
# properly and stops it cleanly when river exits. Same pattern sway uses.
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE PATH 2>/dev/null || true
  systemctl --user start river-session.target 2>/dev/null || true
fi

# --- core keybinds ----------------------------------------------------------
# XMONAD BINDINGS, deliberately.
#
# This whole section mirrors xmonad's defaults rather than i3/Hyprland's,
# because that is the muscle memory that stuck. The two schemes disagree in
# ways that matter: xmonad uses j/k for focus and h/l to resize the main area,
# where i3 uses hjkl for directional focus. Mixing them produces a config that
# feels wrong in a way that is hard to name.
#
# xmonad default          river equivalent
# ----------------------  ------------------------------------------
# Mod+Shift+Return        spawn terminal
# Mod+p                   launcher
# Mod+Shift+c             close window
# Mod+j / Mod+k           focus next / previous
# Mod+Shift+j / +k        swap next / previous
# Mod+h / Mod+l           shrink / grow the main area
# Mod+Return              promote focused view to main   (river: zoom)
# Mod+comma / Mod+period  more / fewer views in main
# Mod+Space               cycle layout   (river: cycle main-location)
# Mod+t                   sink a floating window back into the tiling
# Mod+Shift+q             quit
riverctl map normal "$mod"+Shift Return spawn kitty
riverctl map normal "$mod" P            spawn fuzzel
riverctl map normal "$mod"+Shift C      close
riverctl map normal "$mod"+Shift Q      exit

# Focus and swap — j/k, xmonad style.
riverctl map normal "$mod" J focus-view next
riverctl map normal "$mod" K focus-view previous
riverctl map normal "$mod"+Shift J swap next
riverctl map normal "$mod"+Shift K swap previous

# Resize the main area — h/l, xmonad style. This is the control you reach for
# constantly in a main-and-stack layout, which is why xmonad gave it the home
# keys and why it keeps them here.
riverctl map normal "$mod" H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal "$mod" L send-layout-cmd rivertile "main-ratio +0.05"

# How many views share the main area. xmonad used comma/period.
riverctl map normal "$mod" comma  send-layout-cmd rivertile "main-count +1"
riverctl map normal "$mod" period send-layout-cmd rivertile "main-count -1"

# Promote the focused view to main — xmonad's Mod+Return.
riverctl map normal "$mod" Return zoom

# Where the main area sits. rivertile does the arranging; you pick the axis.
# river has one layout generator at a time rather than xmonad's layout list,
# so cycling main-location is the nearest thing to Mod+Space cycling layouts.
riverctl map normal "$mod" Up    send-layout-cmd rivertile "main-location top"
riverctl map normal "$mod" Right send-layout-cmd rivertile "main-location right"
riverctl map normal "$mod" Down  send-layout-cmd rivertile "main-location bottom"
riverctl map normal "$mod" Left  send-layout-cmd rivertile "main-location left"

riverctl map normal "$mod" F toggle-fullscreen
riverctl map normal "$mod" T toggle-float     # xmonad's Mod+t: sink back to tiling
riverctl map normal "$mod"+Shift Space toggle-float

# Mouse: move and resize floating windows.
riverctl map-pointer normal "$mod" BTN_LEFT  move-view
riverctl map-pointer normal "$mod" BTN_RIGHT resize-view

# --- tags -------------------------------------------------------------------
# river tags are a BITMASK, not workspaces. A view can carry several, and the
# visible set is a mask — which is what makes the scratchpad below work
# without leaving the tag you are on.
for i in $(seq 1 9); do
  tag=$(( 1 << (i - 1) ))
  riverctl map normal "$mod" "$i"               set-focused-tags  "$tag"
  riverctl map normal "$mod"+Shift "$i"         set-view-tags     "$tag"
  riverctl map normal "$mod"+Control "$i"       toggle-focused-tags "$tag"
  riverctl map normal "$mod"+Shift+Control "$i" toggle-view-tags  "$tag"
done

all_tags=$(( (1 << 32) - 1 ))
riverctl map normal "$mod" 0 set-focused-tags "$all_tags"

# --- scratchpad -------------------------------------------------------------
# Tag 10 (bit 9) is reserved. Super+grave ADDS it to the visible mask rather
# than switching to it, so the scratchpad floats over whatever you were doing
# and vanishes again without changing tags. That is a real scratchpad, using
# river's own model rather than emulating someone else's.
scratch_tag=$(( 1 << 9 ))

# Super+s, NOT Super+grave.
#
# `grave` is the idiomatic scratchpad key on a US layout, but on the Spanish
# layout the key left of 1 emits `masculine` (º/ª) — and river binds by
# KEYSYM, so Super+grave would silently never fire. A binding that does
# nothing and reports nothing is the worst kind.
#
# Letters are layout-stable; symbols are not. Anything bound to punctuation in
# this file should be treated as suspect until `wev` says otherwise.
riverctl map normal "$mod" S toggle-focused-tags "$scratch_tag"
riverctl map normal "$mod"+Shift S set-view-tags "$scratch_tag"

# --- hardware keys ----------------------------------------------------------
# Nothing handles these for you here. All four are laptop-specific and all
# four are on the "test before relying on it" list.
riverctl map normal None XF86AudioRaiseVolume  spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+'
riverctl map normal None XF86AudioLowerVolume  spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
riverctl map normal None XF86AudioMute         spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
riverctl map normal None XF86AudioMicMute      spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
riverctl map normal None XF86MonBrightnessUp   spawn 'brightnessctl set 5%+'
riverctl map normal None XF86MonBrightnessDown spawn 'brightnessctl set 5%-'

# Media keys work in locked mode too, so music can be paused at the lock screen.
for mode in normal locked; do
  riverctl map $mode None XF86AudioMedia spawn 'playerctl play-pause' 2>/dev/null || true
done

# --- screenshots ------------------------------------------------------------
# Print          : region -> annotate in swappy
# Shift+Print    : region -> straight to clipboard
# Super+Print    : whole output -> ~/Pictures/Screenshots
riverctl map normal None  Print spawn 'grim -g "$(slurp)" - | swappy -f -'
riverctl map normal Shift Print spawn 'grim -g "$(slurp)" - | wl-copy'
riverctl map normal "$mod" Print spawn 'mkdir -p ~/Pictures/Screenshots && grim ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png'

# --- session ----------------------------------------------------------------
# Session. NOT Super+Control+L — that is main-ratio now. Super+Escape locks,
# which is also closer to the Plasma habit.
riverctl map normal "$mod" Escape spawn swaylock
riverctl map normal "$mod"+Shift P spawn wlogout
riverctl map normal "$mod" V spawn 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'

# Super+Shift+H — searchable keybind reference, parsed from THIS file so it
# cannot drift out of date.
#
# Third choice of key, and the reasoning is worth keeping:
#   Super+?  — `?` is Shift+apostrophe on the Spanish layout, not Shift+slash,
#              so the `slash` keysym never fires.
#   Super+F1 — layout-stable, but this ThinkPad's top row is Fn-first, making
#              it a three-key chord: Fn+Super+F1.
#   Super+Shift+H — a letter, so layout-stable; H for Help; and free, since
#              plain Super+H is main-ratio and Super+Shift+J/K are the swaps.
#
# General rule this keeps proving: bind to LETTERS. Symbols move with the
# layout and the function row moves with the hardware.
#
# ABSOLUTE PATHS, not bare names. These two are the only bindings that call
# something outside /usr/bin, and both were broken in this file until
# 2026-08-24: `spawn river-cheatsheet` resolves against RIVER's PATH, which
# this script cannot change (see the environment section), and river's PATH
# comes from the display manager without ~/.local/bin on it. The binding fired
# and silently exec'd nothing.
#
# It was diagnosed as working, because running river-cheatsheet in a terminal
# succeeds — fish adds ~/.local/bin via fish_add_path, so the shell finds what
# river cannot. bin/river-session now puts ~/.local/bin on river's PATH, but
# these stay absolute: a binding that works without depending on the wrapper
# being installed is worth more than the symmetry.
riverctl map normal "$mod"+Shift H spawn "$HOME/.local/bin/river-cheatsheet"
riverctl map normal "$mod" W spawn "$HOME/.local/bin/river-wallpaper"

# Super+Shift+I — pause the auto-lock for 60 minutes, or resume it now.
#
# For the case this was written for: stepping away from a working session on a
# machine you can see, where a lock screen every five minutes is friction
# rather than security. It EXPIRES on its own — the risk being managed is not
# "someone walks up right now", it is forgetting on a Tuesday and carrying an
# unlocking laptop to campus on Wednesday (04-privacy/threat-model.md,
# adversary #3).
#
# `river-idle stop 0` from a terminal pauses it indefinitely, deliberately
# requiring more effort than a keypress.
riverctl map normal "$mod"+Shift I spawn "$HOME/.local/bin/river-idle toggle"

# --- input ------------------------------------------------------------------
# Touchpad. Device names are machine-specific, so match rather than hardcode:
# a hardcoded name silently stops applying after a kernel or firmware change.
riverctl list-inputs 2>/dev/null | grep -i -E 'touchpad|synaptics' | while read -r dev; do
  try riverctl input "$dev" tap enabled
  try riverctl input "$dev" natural-scroll enabled
  try riverctl input "$dev" scroll-method two-finger
  try riverctl input "$dev" disable-while-typing enabled
done || true

# KEYBOARD LAYOUT — Spanish.
#
# river defaults to `us` and has no idea what your hardware is. Plasma was
# setting this; river sets nothing. Without this line every symbol and every
# accented character is in the wrong place, which is a confusing way to
# discover a compositor "doesn't work".
#
# Verify a binding actually fires with:  wev   (shows the keysym you produced)
try riverctl keyboard-layout es

try riverctl focus-follows-cursor normal
try riverctl set-cursor-warp on-output-change
try riverctl set-repeat 50 300
# breeze_cursors, matching what Plasma set in ~/.config/gtk-*/settings.ini.
# A different cursor theme per session is the kind of small inconsistency that
# reads as "something is broken" without being nameable.
try riverctl xcursor-theme breeze_cursors 24

# --- appearance -------------------------------------------------------------
# gruvbox dark, matching kitty, neovim, zathura and waybar.
riverctl background-color   0x282828
riverctl border-color-focused   0xd79921   # gruvbox yellow
riverctl border-color-unfocused 0x504945   # bg2
riverctl border-color-urgent    0xfb4934   # bright red
riverctl border-width 2

# --- rules ------------------------------------------------------------------
# Float things that are dialogs pretending to be windows.
try riverctl rule-add -app-id 'scratchpad'  float
try riverctl rule-add -app-id 'pavucontrol' float
# waybar's cpu/memory modules open btop with this app-id; a monitor you opened
# by clicking the bar should appear over the work, not retile it.
try riverctl rule-add -app-id 'floatterm'   float
try riverctl rule-add -app-id 'blueman-manager' float
try riverctl rule-add -app-id 'org.kde.polkit-kde-authentication-agent-1' float
try riverctl rule-add -app-id '*' ssd        # server-side decorations: river draws
                                         # the border, apps don't draw their own

# --- layout -----------------------------------------------------------------
riverctl default-layout rivertile
# Gaps. -view-padding is between windows, -outer-padding is against the screen
# edge; equal values give visually even spacing.
rivertile -view-padding 6 -outer-padding 6 -main-ratio 0.55 &

# --- autostart --------------------------------------------------------------
# Everything Plasma used to do. Each line is guarded so a missing package
# degrades one feature instead of aborting the session.
#
# run() is SINGLETON. Starting river a second time inside one login — or
# restarting it after a crash — otherwise stacks a second copy of every
# daemon, and the tray ones announce themselves on the same D-Bus object:
#
#   Status Notifier Item with bus name ':1.642' and object path
#   '/org/ayatana/NotificationItem/nm_applet' is already registered
#
# waybar then shows one applet and ignores the other, so the wifi menu you
# click is not necessarily the process you think it is. Observed 2026-08-23.
#
# pgrep -x matches the executable name exactly and -u restricts to this user,
# so a system daemon of the same name elsewhere does not suppress ours.
#
# CAVEAT, so this is not mistaken for more than it is: -x matches comm, which
# for an interpreted script is the INTERPRETER ("python3", "bash"), not the
# script. So this deduplicates the compiled daemons — waybar, swaync,
# nm-applet, wl-paste — and does nothing for blueman-applet, which is Python.
# That is no worse than before and covers the one that actually misbehaved.
# Tested against a mock daemon: three consecutive calls, one process.
run() {
  command -v "$1" >/dev/null 2>&1 || return 0
  pgrep -x -u "$(id -u)" "$1" >/dev/null 2>&1 && return 0
  "$@" &
}

# Secret Service — Signal, Element and anything using libsecret need this.
# gnome-keyring rather than kwallet: it works outside a Plasma session without
# assuming Plasma is there. See packages/bundles/river.txt.
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null)"
  export SSH_AUTH_SOCK
fi

# polkit agent. WITHOUT THIS, anything needing authorisation fails silently —
# no prompt, no error. Binary comes from the already-installed polkit-kde.
[ -x /usr/libexec/polkit-kde-authentication-agent-1 ] && \
  /usr/libexec/polkit-kde-authentication-agent-1 &

# GTK4/libadwaita apps ignore gtk-theme-name and follow the colour-scheme
# preference through the portal instead, so ~/.config/gtk-*/settings.ini alone
# is not enough for them.
#
# ONLY colour-scheme is set here. Theme, icons and cursor are deliberately left
# alone: Plasma owns ~/.config/gtk-*/settings.ini, has already set Breeze and
# breeze-dark coherently, and overriding them from river would make GTK apps
# look different depending on which session launched them — worse than either
# choice on its own.
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true
fi

run waybar
run swaync
run nm-applet --indicator
run blueman-applet
# kanshi only if it has a config. Started bare it prints "failed to parse
# config file" and exits — which is what that error in the first nested run
# was. Its config needs real output names (eDP-1 and whatever the projector
# reports), so it stays unstarted until those are known: see
# `wlr-randr` inside a river session.
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/kanshi/config" ] && run kanshi
run river-wallpaper --restore   # re-applies the last choice; silent if none
run wl-paste --watch cliphist store

# Idle: lock at 5 min, screen off at 6, suspend at 15.
#
# The swayidle invocation used to be inline here. It now lives in
# bin/river-idle, which owns the whole idle policy — because the timings are
# needed in two places, not one: at session start, and again whenever the
# timers are re-armed after being paused. Two copies of "how long until the
# screen locks" would drift, and the direction they drift in is "the laptop
# stopped locking and nobody noticed".
#
# Pause it with Super+Shift+I, or by clicking the bar indicator. Both call the
# same script, so they cannot disagree about the state.
[ -x "$HOME/.local/bin/river-idle" ] && "$HOME/.local/bin/river-idle" start >/dev/null 2>&1

# The scratchpad terminal, parked on tag 10 and left there.
# Spawned while tag 10 is focused because river assigns new views to the
# CURRENTLY focused tags — there is no reliable rule for "spawn onto tag N".
riverctl set-focused-tags "$scratch_tag"
kitty --class scratchpad &
sleep 0.4
riverctl set-focused-tags 1
