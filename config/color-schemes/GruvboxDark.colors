# ~/.dotfiles/config/color-schemes/GruvboxDark.colors
#
# Linked to ~/.local/share/color-schemes/GruvboxDark.colors.
# Apply with:  plasma-apply-colorscheme GruvboxDark
#
# Same gruvbox dark palette as config/waybar/style.css, config/river/init's
# border colours, kitty, fuzzel, swaync and zathura:
#
#   bg0_h #1d2021   bg0 #282828   bg1 #3c3836   bg2 #504945   bg3 #665c54
#   fg1  #ebdbb2    fg4 #a89984   gray #928374
#   red  #fb4934    green #b8bb26 yellow #fabd2f  blue #83a598
#   aqua #8ec07c    purple #d3869b orange #fe8019
#
# Selection is #d79921 — the same accent as the focused window border and the
# focused waybar tag. One accent in the session, not three.
#
# This changes PLASMA TOO, because both sessions read ~/.config/kdeglobals.
# That is the intent: one source of truth. It is not a river-only theme.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

